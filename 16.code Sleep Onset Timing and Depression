make_formula <- function(exposure, covars = NULL, knots = 4) {
  
  rhs <- paste0("rcs(", exposure, ", ", knots, ")")
  
  if (!is.null(covars) && length(covars) > 0) {
    rhs <- paste(rhs, paste(covars, collapse = " + "), sep = " + ")
  }
  
  as.formula(paste(outcome_var, "~", rhs))
}

fit_svy_rcs <- function(exposure, covars = NULL, knots = 4) {
  
  svyglm(
    formula = make_formula(exposure, covars, knots),
    design = design,
    family = quasibinomial()
  )
}

