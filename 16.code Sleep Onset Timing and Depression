summarise_nadir <- function(dat, label) {
  
  idx <- which.min(dat$yhat)
  nadir_or <- dat$yhat[idx]
  
  ref_dat <- dat[dat$yhat <= VAL_REF * nadir_or, ]
  
  data.frame(
    timing = label,
    nadir_hour = dat$hours[idx],
    nadir_or = nadir_or,
    reference_start_hour = min(ref_dat$hours, na.rm = TRUE),
    reference_end_hour = max(ref_dat$hours, na.rm = TRUE)
  )
}

