  get_rcs_pvalues_wald(model_weekday_m2, exposure_weekday, "Model 2", "Weekday"),
  get_rcs_pvalues_wald(model_weekday_m3, exposure_weekday, "Model 3", "Weekday"),
  get_rcs_pvalues_wald(model_weekday_m4, exposure_weekday, "Model 4", "Weekday"),
  
