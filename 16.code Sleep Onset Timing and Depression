journal_theme_bare <- function(base_size = 10) {
  
  theme_bw(base_size = base_size, base_family = "Arial") +
    theme(
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      panel.border = element_rect(
        colour = "black",
        linewidth = 0.6,
        fill = NA
      ),
      axis.title = element_blank(),
      axis.text = element_text(
        colour = "black",
        size = base_size * 0.9
      ),
      axis.ticks = element_line(
        colour = "black",
        linewidth = 0.35
      ),
      axis.ticks.length = unit(2, "pt"),
      legend.position = "none",
      plot.title = element_blank(),
      plot.margin = margin(6, 8, 4, 6)
    )
}

color_scheme <- c(
  "Weekday" = "#0072B2",
  "Weekend" = "#D55E00"
)

build_bare_panel <- function(dat) {
  
  plot_data <- dat %>%
    mutate(
      time_type = factor(
        time_type,
        levels = c("Weekday", "Weekend")
      )
    )
  
  y_raw_min <- min(plot_data$lower, na.rm = TRUE)
  y_raw_max <- max(plot_data$upper, na.rm = TRUE)
  
  y_lo <- max(0, floor(y_raw_min * 2) / 2)
  y_hi <- ceiling(y_raw_max * 2) / 2
  
  y_lo <- min(y_lo, 0.8)
  y_hi <- max(y_hi, 1.5)
  
  y_breaks <- pretty(c(y_lo, y_hi), n = 5)
  y_breaks <- y_breaks[y_breaks >= y_lo & y_breaks <= y_hi]
  
  ggplot(
    plot_data,
    aes(
      x = hours,
      y = yhat,
      group = time_type
    )
  ) +
    geom_ribbon(
      aes(
        ymin = lower,
        ymax = upper,
        fill = time_type
      ),
      alpha = 0.18,
      colour = NA
    ) +
    geom_hline(
      yintercept = 1,
      linetype = "dashed",
      colour = "grey40",
      linewidth = 0.45
    ) +
    geom_line(
      aes(colour = time_type),
      linewidth = 0.85
    ) +
    scale_colour_manual(values = color_scheme) +
    scale_fill_manual(values = color_scheme) +
    scale_x_continuous(
      breaks = seq(0, 24, by = 4),
      limits = c(0, 24),
      expand = expansion(mult = c(0.01, 0.01))
    ) +
    scale_y_continuous(
      limits = c(y_lo, y_hi),
      breaks = y_breaks,
      expand = expansion(mult = c(0, 0.02))
    ) +
    journal_theme_bare()
}

