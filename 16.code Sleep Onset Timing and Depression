    overall_p_fmt = sapply(overall_p, format_p),
    nonlinear_p_fmt = sapply(nonlinear_p, format_p)
  ) %>%
  dplyr::select(
    Model = model,
    Timing = timing,
    `Overall P` = overall_p_fmt,
    `Nonlinear P` = nonlinear_p_fmt
  )

