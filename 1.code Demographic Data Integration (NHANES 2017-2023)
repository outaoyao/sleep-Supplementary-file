################################################################################
# Script Name: 1. Demographic Data Integration (NHANES 2017-2023)
# Purpose:
#   Download, clean, re-weight, and merge NHANES demographic cycles.
#   Harmonize age, PIR, marital status, education, race/ethnicity and pregnancy.
#
# Critical fix:
#   DMDMARTZ is label/character-type after nhanesA import.
#   Do NOT use mutate(across(everything(), as.numeric)),
#   otherwise marital status labels will be corrupted.
#
# Manuscript-consistent version:
#   - NHANES 2017-March 2020 + 2021-2023
#   - MEC weights recalibrated to 5.2-year combined cycle
#   - Age categories: 20-39, 40-59, >=60
#   - PIR categories: <1.30, 1.30-3.50, >=3.50
#   - Marital status:
#       Married/Living with Partner
#       Widowed/Divorced/Separated
#       Never married
################################################################################

# 1. Load Required Libraries ---------------------------------------------------

library(nhanesA)
library(tidyverse)

# 2. Environment Setup ---------------------------------------------------------

source_dir <- "D:/code"
export_dir <- "D:/code"

if (!dir.exists(export_dir)) {
  dir.create(export_dir, recursive = TRUE)
}

qc_dir <- file.path(export_dir, "qc_outputs")
if (!dir.exists(qc_dir)) {
  dir.create(qc_dir, recursive = TRUE)
}

# 3. Helper Functions ----------------------------------------------------------

clean_valid <- function(x, valid_values) {
  x <- as.numeric(x)
  ifelse(x %in% valid_values, x, NA_real_)
}

make_age_cat <- function(age) {
  case_when(
    age >= 20 & age <= 39 ~ "20-39",
    age >= 40 & age <= 59 ~ "40-59",
    age >= 60             ~ "≥60",
    TRUE                  ~ NA_character_
  )
}

make_pir_cat <- function(pir) {
  case_when(
    is.na(pir)               ~ NA_character_,
    pir < 1.30               ~ "<1.30",
    pir >= 1.30 & pir < 3.50 ~ "1.30-3.50",
    pir >= 3.50              ~ "≥3.50",
    TRUE                     ~ NA_character_
  )
}

make_marital_cat <- function(x) {
  x <- as.character(x)
  
  case_when(
    x %in% c(
      "Married/Living with Partner",
      "Married/Living with partner"
    ) ~ "Married/Living with Partner",
    
    x == "Widowed/Divorced/Separated" ~ "Widowed/Divorced/Separated",
    
    x == "Never married" ~ "Never married",
    
    x %in% c(
      "Refused",
      "Don't Know",
      "Don't know"
    ) ~ NA_character_,
    
    is.na(x) ~ NA_character_,
    
    TRUE ~ NA_character_
  )
}

make_education_cat <- function(x) {
  case_when(
    x == 1 ~ "Less than 9th grade",
    x == 2 ~ "9-11th grade",
    x == 3 ~ "High school graduate/GED",
    x == 4 ~ "Some college or AA degree",
    x == 5 ~ "College graduate or above",
    TRUE   ~ NA_character_
  )
}

make_race_cat <- function(x) {
  case_when(
    x == 1 ~ "Mexican American",
    x == 2 ~ "Other Hispanic",
    x == 3 ~ "Non-Hispanic White",
    x == 4 ~ "Non-Hispanic Black",
    x == 5 ~ "Other Race",
    TRUE   ~ NA_character_
  )
}

make_sex_cat <- function(x) {
  case_when(
    x == 1 ~ "Male",
    x == 2 ~ "Female",
    TRUE   ~ NA_character_
  )
}

# 4. Process Cycle 1: 2017-March 2020 -----------------------------------------

cat("Processing NHANES 2017-March 2020 cycle...\n")

demo_1720_raw <- nhanes("P_DEMO")

cat("\nRaw 2017-2020 DMDMARTZ distribution:\n")
print(table(demo_1720_raw$DMDMARTZ, useNA = "ifany"))

demo_1720 <- demo_1720_raw %>%
  select(
    SEQN, SDDSRVYR, RIDSTATR, RIAGENDR, RIDAGEYR, RIDRETH1,
    DMDEDUC2, DMDMARTZ, RIDEXPRG, WTINTPRP, WTMECPRP,
    SDMVPSU, SDMVSTRA, INDFMPIR
  ) %>%
  mutate(
    across(
      c(
        SEQN, SDDSRVYR, RIDSTATR, RIAGENDR, RIDAGEYR, RIDRETH1,
        DMDEDUC2, RIDEXPRG, WTINTPRP, WTMECPRP,
        SDMVPSU, SDMVSTRA, INDFMPIR
      ),
      as.numeric
    )
  ) %>%
  mutate(
    CYCLE = "2017-2020",
    
    RIAGENDR = clean_valid(RIAGENDR, 1:2),
    RIDRETH1 = clean_valid(RIDRETH1, 1:5),
    DMDEDUC2 = clean_valid(DMDEDUC2, 1:5),
    
    # Pregnancy status:
    # 1 Yes; 2 No; 3 Cannot ascertain
    RIDEXPRG = clean_valid(RIDEXPRG, 1:3),
    
    mec_adj = (3.2 / 5.2) * WTMECPRP,
    int_adj = (3.2 / 5.2) * WTINTPRP
  )

# 5. Process Cycle 2: 2021-2023 ------------------------------------------------

cat("\nProcessing NHANES 2021-2023 cycle...\n")

demo_2123_raw <- nhanes("DEMO_L")

cat("\nRaw 2021-2023 DMDMARTZ distribution:\n")
print(table(demo_2123_raw$DMDMARTZ, useNA = "ifany"))

demo_2123 <- demo_2123_raw %>%
  select(
    SEQN, SDDSRVYR, RIDSTATR, RIAGENDR, RIDAGEYR, RIDRETH1,
    DMDEDUC2, DMDMARTZ, RIDEXPRG, WTINT2YR, WTMEC2YR,
    SDMVPSU, SDMVSTRA, INDFMPIR
  ) %>%
  mutate(
    across(
      c(
        SEQN, SDDSRVYR, RIDSTATR, RIAGENDR, RIDAGEYR, RIDRETH1,
        DMDEDUC2, RIDEXPRG, WTINT2YR, WTMEC2YR,
        SDMVPSU, SDMVSTRA, INDFMPIR
      ),
      as.numeric
    )
  ) %>%
  mutate(
    CYCLE = "2021-2023",
    
    RIAGENDR = clean_valid(RIAGENDR, 1:2),
    RIDRETH1 = clean_valid(RIDRETH1, 1:5),
    DMDEDUC2 = clean_valid(DMDEDUC2, 1:5),
    RIDEXPRG = clean_valid(RIDEXPRG, 1:3),
    
    mec_adj = (2.0 / 5.2) * WTMEC2YR,
    int_adj = (2.0 / 5.2) * WTINT2YR
  )

# 6. Merge, Harmonize, and Categorize -----------------------------------------

cat("\nMerging datasets and creating manuscript-consistent variables...\n")

demo_combined <- bind_rows(demo_1720, demo_2123) %>%
  mutate(
    sex = factor(
      make_sex_cat(RIAGENDR),
      levels = c("Male", "Female")
    ),
    
    race_ethnicity = factor(
      make_race_cat(RIDRETH1),
      levels = c(
        "Mexican American",
        "Other Hispanic",
        "Non-Hispanic White",
        "Non-Hispanic Black",
        "Other Race"
      )
    ),
    
    education = factor(
      make_education_cat(DMDEDUC2),
      levels = c(
        "Less than 9th grade",
        "9-11th grade",
        "High school graduate/GED",
        "Some college or AA degree",
        "College graduate or above"
      )
    ),
    
    marital_status = factor(
      make_marital_cat(DMDMARTZ),
      levels = c(
        "Married/Living with Partner",
        "Widowed/Divorced/Separated",
        "Never married"
      )
    ),
    
    Age_cat = factor(
      make_age_cat(RIDAGEYR),
      levels = c("20-39", "40-59", "≥60")
    ),
    
    PIR_cat = factor(
      make_pir_cat(INDFMPIR),
      levels = c("<1.30", "1.30-3.50", "≥3.50")
    ),
    
    Age_cat_num = as.numeric(Age_cat),
    PIR_cat_num = as.numeric(PIR_cat),
    
    pregnancy_yes = ifelse(RIDEXPRG == 1, 1, 0),
    
    adult_20plus = ifelse(RIDAGEYR >= 20, 1, 0),
    
    positive_mec_weight = ifelse(!is.na(mec_adj) & mec_adj > 0, 1, 0),
    positive_int_weight = ifelse(!is.na(int_adj) & int_adj > 0, 1, 0)
  )

# 7. QC ------------------------------------------------------------------------

cat("\n--- Basic Sample QC ---\n")
cat("Total participants:", nrow(demo_combined), "\n")
cat("2017-2020 participants:", sum(demo_combined$CYCLE == "2017-2020"), "\n")
cat("2021-2023 participants:", sum(demo_combined$CYCLE == "2021-2023"), "\n")
cat("Adults aged >=20:", sum(demo_combined$adult_20plus == 1, na.rm = TRUE), "\n")
cat("Pregnant participants:", sum(demo_combined$pregnancy_yes == 1, na.rm = TRUE), "\n")
cat("Participants with positive MEC weight:", sum(demo_combined$positive_mec_weight == 1, na.rm = TRUE), "\n")
cat("Participants with positive interview weight:", sum(demo_combined$positive_int_weight == 1, na.rm = TRUE), "\n")

cat("\n--- Missingness Audit: Key Demographic Variables ---\n")

missing_audit <- demo_combined %>%
  summarise(
    n_total = n(),
    
    missing_age = sum(is.na(RIDAGEYR)),
    missing_age_cat_among_adults = sum(is.na(Age_cat) & RIDAGEYR >= 20, na.rm = TRUE),
    
    missing_sex = sum(is.na(sex)),
    missing_race = sum(is.na(race_ethnicity)),
    missing_education_all = sum(is.na(education)),
    missing_education_among_adults = sum(is.na(education) & RIDAGEYR >= 20, na.rm = TRUE),
    
    missing_marital_status_all = sum(is.na(marital_status)),
    missing_marital_status_among_adults = sum(is.na(marital_status) & RIDAGEYR >= 20, na.rm = TRUE),
    
    missing_pir_raw_all = sum(is.na(INDFMPIR)),
    missing_pir_cat_all = sum(is.na(PIR_cat)),
    missing_pir_cat_among_adults = sum(is.na(PIR_cat) & RIDAGEYR >= 20, na.rm = TRUE),
    
    missing_mec_weight = sum(is.na(mec_adj)),
    zero_or_negative_mec_weight = sum(!is.na(mec_adj) & mec_adj <= 0),
    
    missing_int_weight = sum(is.na(int_adj)),
    zero_or_negative_int_weight = sum(!is.na(int_adj) & int_adj <= 0),
    
    missing_psu = sum(is.na(SDMVPSU)),
    missing_strata = sum(is.na(SDMVSTRA))
  )

print(missing_audit)

cat("\n--- Age Category Distribution among Adults ---\n")
age_dist_adults <- demo_combined %>%
  filter(RIDAGEYR >= 20) %>%
  count(Age_cat, name = "n")

print(age_dist_adults)

cat("\n--- Marital Status Distribution among Adults ---\n")
marital_dist_adults <- demo_combined %>%
  filter(RIDAGEYR >= 20) %>%
  count(marital_status, name = "n")

print(marital_dist_adults)

cat("\n--- PIR Category Distribution among Adults ---\n")
pir_dist_adults <- demo_combined %>%
  filter(RIDAGEYR >= 20) %>%
  count(PIR_cat, name = "n")

print(pir_dist_adults)

cat("\n--- Education Distribution among Adults ---\n")
education_dist_adults <- demo_combined %>%
  filter(RIDAGEYR >= 20) %>%
  count(education, name = "n")

print(education_dist_adults)

cat("\n--- Raw DMDMARTZ Distribution after Merge ---\n")
raw_marital_after_merge <- demo_combined %>%
  count(CYCLE, DMDMARTZ, name = "n")

print(raw_marital_after_merge)

cat("\n--- Weight Summary by Cycle ---\n")

weight_summary <- demo_combined %>%
  group_by(CYCLE) %>%
  summarise(
    N = n(),
    
    Mean_MEC_Adj = mean(mec_adj, na.rm = TRUE),
    Median_MEC_Adj = median(mec_adj, na.rm = TRUE),
    Min_MEC_Adj = min(mec_adj, na.rm = TRUE),
    Max_MEC_Adj = max(mec_adj, na.rm = TRUE),
    
    Mean_INT_Adj = mean(int_adj, na.rm = TRUE),
    Median_INT_Adj = median(int_adj, na.rm = TRUE),
    Min_INT_Adj = min(int_adj, na.rm = TRUE),
    Max_INT_Adj = max(int_adj, na.rm = TRUE),
    
    N_zero_or_negative_MEC = sum(!is.na(mec_adj) & mec_adj <= 0),
    N_zero_or_negative_INT = sum(!is.na(int_adj) & int_adj <= 0),
    
    .groups = "drop"
  )

print(weight_summary)

cat("\n--- Check for Impossible Values ---\n")

range_qc <- demo_combined %>%
  summarise(
    min_age = min(RIDAGEYR, na.rm = TRUE),
    max_age = max(RIDAGEYR, na.rm = TRUE),
    
    min_pir = min(INDFMPIR, na.rm = TRUE),
    max_pir = max(INDFMPIR, na.rm = TRUE),
    
    min_mec_adj = min(mec_adj, na.rm = TRUE),
    max_mec_adj = max(mec_adj, na.rm = TRUE),
    
    min_int_adj = min(int_adj, na.rm = TRUE),
    max_int_adj = max(int_adj, na.rm = TRUE)
  )

print(range_qc)

# 8. Save QC Outputs -----------------------------------------------------------

write_csv(missing_audit, file.path(qc_dir, "Step1_demographic_missingness_audit.csv"))
write_csv(age_dist_adults, file.path(qc_dir, "Step1_age_distribution_adults.csv"))
write_csv(marital_dist_adults, file.path(qc_dir, "Step1_marital_distribution_adults.csv"))
write_csv(pir_dist_adults, file.path(qc_dir, "Step1_pir_distribution_adults.csv"))
write_csv(education_dist_adults, file.path(qc_dir, "Step1_education_distribution_adults.csv"))
write_csv(raw_marital_after_merge, file.path(qc_dir, "Step1_raw_DMDMARTZ_after_merge.csv"))
write_csv(weight_summary, file.path(qc_dir, "Step1_weight_summary_by_cycle.csv"))
write_csv(range_qc, file.path(qc_dir, "Step1_range_qc.csv"))

# 9. Export Final Dataset ------------------------------------------------------

export_path <- file.path(export_dir, "1.data.rds")
saveRDS(demo_combined, export_path)

cat("\nSuccess! Integrated demographics saved to:", export_path, "\n")
cat("QC files saved to:", qc_dir, "\n")
