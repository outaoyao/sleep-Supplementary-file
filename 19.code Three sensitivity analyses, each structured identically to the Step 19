  stop("SA1 — weighted quartile cut points are not sufficiently unique.")
}

dat_sa1 <- dat_sa1 %>%
  mutate(
    CMB_Q = cut(
      .data[[exposure_var_sa1]],
      breaks         = q_values_sa1,
      include.lowest = TRUE,
      labels         = FALSE
    ),
    CMB_Trend = as.numeric(CMB_Q)
  )

