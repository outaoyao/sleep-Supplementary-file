################################################################################
# Script Name: 7. Covariate Processing - Diabetes Status
# Purpose:
#   Harmonize NHANES diabetes / borderline diabetes status across 2017-2023 cycles.
#
# Manuscript-consistent definition:
#   Diabetes or borderline diabetes was defined using self-reported physician
#   diagnosis from DIQ010.
#
# Core variable:
#   DIQ010:
#     Doctor told you have diabetes
#     1 = Yes
#     2 = No
#     3 = Borderline
#     7 = Refused
#     9 = Don't know
#
# Analytic variable:
#   diabetes_or_prediabetes:
#     0 = No
#     1 = Yes or borderline diabetes
#
# Data Cycles:
#   - 2017-March 2020: P_DIQ
#   - 2021-2023: DIQ_L
#
# Output:
#   - D:/code/7.data.rds
################################################################################

# 1. Environment & Libraries ---------------------------------------------------

library(nhanesA)
library(tidyverse)
library(stringr)

# 2. Environment ---------------------------------------------------------------

export_dir <- "D:/code"

if (!dir.exists(export_dir)) {
  dir.create(export_dir, recursive = TRUE)
}

qc_dir <- file.path(export_dir, "qc_outputs")

if (!dir.exists(qc_dir)) {
  dir.create(qc_dir, recursive = TRUE)
}

# 3. Helper Functions ----------------------------------------------------------

clean_diq010_code <- function(x) {
  
  x_chr <- as.character(x)
  x_chr <- str_trim(x_chr)
  x_low <- str_to_lower(x_chr)
  
  case_when(
    is.na(x_chr) ~ NA_real_,
    
    # Numeric codes
    x_chr == "1" ~ 1,
    x_chr == "2" ~ 2,
    x_chr == "3" ~ 3,
    
    # Character labels from nhanesA
    x_low == "yes" ~ 1,
    x_low == "no" ~ 2,
    str_detect(x_low, "borderline") ~ 3,
    
    # Invalid / missing response labels
    x_low %in% c(
      "",
      ".",
      "7",
      "9",
      "77",
      "99",
      "refused",
      "don't know",
      "dont know",
      "missing",
      "na"
    ) ~ NA_real_,
    
    TRUE ~ NA_real_
  )
}

process_diabetes_cycle <- function(table_name, cycle_label) {
  
  cat("Processing diabetes data:", cycle_label, "\n")
  
  raw_data <- nhanes(table_name)
  
  required_vars <- c("SEQN", "DIQ010")
  
  missing_vars <- setdiff(required_vars, names(raw_data))
  
  if (length(missing_vars) > 0) {
    stop(
      "Missing required diabetes variables in ",
      table_name,
      ": ",
      paste(missing_vars, collapse = ", ")
    )
  }
  
  cat("\nRaw DIQ010 distribution for", cycle_label, ":\n")
  print(table(raw_data$DIQ010, useNA = "ifany"))
  
  processed <- raw_data %>%
    as_tibble() %>%
    select(all_of(required_vars)) %>%
    mutate(
      SEQN = suppressWarnings(as.numeric(SEQN)),
      
      DIQ010_raw = DIQ010,
      
      DIQ010 = clean_diq010_code(DIQ010),
      
      diabetes_status_3level = case_when(
        DIQ010 == 2 ~ 0, # No
        DIQ010 == 3 ~ 1, # Borderline
        DIQ010 == 1 ~ 2, # Yes
        TRUE        ~ NA_real_
      ),
      
      diabetes_status_3level_label = factor(
        diabetes_status_3level,
        levels = c(0, 1, 2),
        labels = c(
          "No",
          "Borderline",
          "Yes"
        )
      ),
      
      diabetes_or_prediabetes = case_when(
        DIQ010 == 2 ~ 0,
        DIQ010 %in% c(1, 3) ~ 1,
        TRUE ~ NA_real_
      ),
      
      diabetes_or_prediabetes_label = factor(
        diabetes_or_prediabetes,
        levels = c(0, 1),
        labels = c(
          "No",
          "Yes/Borderline"
        )
      ),
      
      # Backward-compatible names used in previous scripts
      diabetes_status = diabetes_or_prediabetes,
      diabetes_label = diabetes_or_prediabetes_label,
      
      CYCLE = cycle_label
    )
  
  return(processed)
}

# 4. Process Cycles ------------------------------------------------------------

diq_1720 <- process_diabetes_cycle("P_DIQ", "2017-2020")
diq_2123 <- process_diabetes_cycle("DIQ_L", "2021-2023")

diabetes_combined <- bind_rows(diq_1720, diq_2123)

# 5. Quality Control -----------------------------------------------------------

cat("\n--- Diabetes / Prediabetes Distribution by Cycle ---\n")

diabetes_dist_cycle <- diabetes_combined %>%
  count(CYCLE, diabetes_or_prediabetes_label, name = "n") %>%
  arrange(CYCLE, diabetes_or_prediabetes_label)

print(diabetes_dist_cycle)

cat("\n--- Diabetes / Prediabetes Overall Distribution ---\n")

diabetes_dist_overall <- diabetes_combined %>%
  count(diabetes_or_prediabetes_label, name = "n") %>%
  arrange(diabetes_or_prediabetes_label)

print(diabetes_dist_overall)

cat("\n--- 3-Level Diabetes Status Distribution ---\n")

diabetes_3level_dist <- diabetes_combined %>%
  count(diabetes_status_3level_label, name = "n") %>%
  arrange(diabetes_status_3level_label)

print(diabetes_3level_dist)

cat("\n--- Missingness Audit ---\n")

missing_audit <- diabetes_combined %>%
  summarise(
    n_total = n(),
    
    missing_DIQ010 =
      sum(is.na(DIQ010)),
    
    missing_diabetes_or_prediabetes =
      sum(is.na(diabetes_or_prediabetes_label)),
    
    n_no_diabetes =
      sum(diabetes_or_prediabetes == 0, na.rm = TRUE),
    
    n_diabetes_or_prediabetes =
      sum(diabetes_or_prediabetes == 1, na.rm = TRUE),
    
    n_borderline =
      sum(diabetes_status_3level == 1, na.rm = TRUE),
    
    n_diabetes_yes =
      sum(diabetes_status_3level == 2, na.rm = TRUE)
  )

print(missing_audit)

cat("\n--- Cycle-specific Missingness Audit ---\n")

missing_audit_cycle <- diabetes_combined %>%
  group_by(CYCLE) %>%
  summarise(
    n_total = n(),
    
    missing_DIQ010 =
      sum(is.na(DIQ010)),
    
    n_no_diabetes =
      sum(diabetes_or_prediabetes == 0, na.rm = TRUE),
    
    n_diabetes_or_prediabetes =
      sum(diabetes_or_prediabetes == 1, na.rm = TRUE),
    
    n_borderline =
      sum(diabetes_status_3level == 1, na.rm = TRUE),
    
    n_diabetes_yes =
      sum(diabetes_status_3level == 2, na.rm = TRUE),
    
    missing_diabetes_or_prediabetes =
      sum(is.na(diabetes_or_prediabetes_label)),
    
    .groups = "drop"
  )

print(missing_audit_cycle)

cat("\n--- Raw-label QC after harmonization ---\n")

raw_label_qc <- diabetes_combined %>%
  count(CYCLE, DIQ010_raw, diabetes_status_3level_label,
        diabetes_or_prediabetes_label, name = "n") %>%
  arrange(CYCLE, DIQ010_raw, diabetes_status_3level_label)

print(raw_label_qc)

# 6. Save QC Outputs -----------------------------------------------------------

write_csv(
  diabetes_dist_cycle,
  file.path(qc_dir, "Step7_diabetes_prediabetes_distribution_by_cycle.csv")
)

write_csv(
  diabetes_dist_overall,
  file.path(qc_dir, "Step7_diabetes_prediabetes_distribution_overall.csv")
)

write_csv(
  diabetes_3level_dist,
  file.path(qc_dir, "Step7_diabetes_3level_distribution.csv")
)

write_csv(
  missing_audit,
  file.path(qc_dir, "Step7_diabetes_missingness_audit.csv")
)

write_csv(
  missing_audit_cycle,
  file.path(qc_dir, "Step7_diabetes_missingness_audit_by_cycle.csv")
)

write_csv(
  raw_label_qc,
  file.path(qc_dir, "Step7_diabetes_raw_label_qc.csv")
)

# 7. Export --------------------------------------------------------------------

save_path <- file.path(export_dir, "7.data.rds")

saveRDS(diabetes_combined, save_path)

cat("\nDiabetes data successfully exported to:", save_path, "\n")
cat("QC files saved to:", qc_dir, "\n")
cat(
  "Final Dataset dimensions:",
  dim(diabetes_combined)[1],
  "rows and",
  dim(diabetes_combined)[2],
  "variables.\n"
)
