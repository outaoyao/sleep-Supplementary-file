# ==============================================================================
# 6. Standardized OR and P for trend
# ==============================================================================

model_z <- fit_svy_logistic(
  "CMB_z",
  model4_covars
)

res_z <- extract_or(
  model_z,
  "Per 1-SD increase",
  var_name = "CMB_z"
) %>%
  mutate(
    OR_round = round(OR, 3),
    lower95_round = round(lower95, 3),
    upper95_round = round(upper95, 3),
    p_fmt = sapply(p_value, format_p)
  )

model_trend <- fit_svy_logistic(
  "CMB_Trend",
  model4_covars
)

trend_coef <- summary(model_trend)$coefficients
p_trend <- trend_coef["CMB_Trend", "Pr(>|t|)"]

trend_result <- data.frame(
  term = "CMB_Trend",
  beta = trend_coef["CMB_Trend", "Estimate"],
  se = trend_coef["CMB_Trend", "Std. Error"],
  OR = exp(trend_coef["CMB_Trend", "Estimate"]),
  lower95 = exp(
    trend_coef["CMB_Trend", "Estimate"] -
      1.96 * trend_coef["CMB_Trend", "Std. Error"]
  ),
  upper95 = exp(
    trend_coef["CMB_Trend", "Estimate"] +
      1.96 * trend_coef["CMB_Trend", "Std. Error"]
  ),
  p_value = p_trend,
  p_fmt = format_p(p_trend)
)

