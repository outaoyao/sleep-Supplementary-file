# ==============================================================================
# 4. Model helpers
# ==============================================================================

make_formula <- function(exposure, covars = NULL) {
  
  rhs <- c(exposure, covars)
  
  as.formula(
    paste(
      outcome_var,
      "~",
      paste(rhs, collapse = " + ")
    )
  )
}

fit_svy_logistic <- function(exposure, covars = NULL) {
  
  svyglm(
    formula = make_formula(exposure, covars),
    design = design_final,
    family = quasibinomial()
  )
}

format_p <- function(p) {
  
  if (is.na(p)) {
    return(NA_character_)
  }
  
  if (p < 0.001) {
    return("<0.001")
  }
  
  sprintf("%.3f", round(p, 3))
}

extract_or <- function(model, label, var_name = "CMB_Score") {
  
  coef_summary <- summary(model)$coefficients
  
  if (!var_name %in% rownames(coef_summary)) {
    stop(
      paste0(
        "Target variable not found in model: ",
        var_name
      )
    )
  }
  
  est <- coef_summary[var_name, "Estimate"]
  se  <- coef_summary[var_name, "Std. Error"]
  p   <- coef_summary[var_name, "Pr(>|t|)"]
  
  data.frame(
    Model = label,
    beta = est,
    se = se,
    OR = exp(est),
    lower95 = exp(est - 1.96 * se),
    upper95 = exp(est + 1.96 * se),
    p_value = p,
    stringsAsFactors = FALSE
  )
}

# ==============================================================================
# 5. Four hierarchical models
# ==============================================================================

model1 <- fit_svy_logistic("CMB_Score", NULL)

model2 <- fit_svy_logistic(
  "CMB_Score",
  model2_covars
)

model3 <- fit_svy_logistic(
  "CMB_Score",
  model3_covars
)

model4 <- fit_svy_logistic(
  "CMB_Score",
  model4_covars
)

results_summary <- bind_rows(
  extract_or(model1, "Model 1"),
  extract_or(model2, "Model 2"),
  extract_or(model3, "Model 3"),
  extract_or(model4, "Model 4")
) %>%
  mutate(
    OR_round = round(OR, 3),
    lower95_round = round(lower95, 3),
    upper95_round = round(upper95, 3),
    p_fmt = sapply(p_value, format_p)
  )

cat("\nFour-model CMB score results:\n")
