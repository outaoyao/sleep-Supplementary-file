# ==============================================================================
# 3. Survey design and weighted quartiles
# ==============================================================================

design_base <- svydesign(
  id = ~SDMVPSU,
  strata = ~SDMVSTRA,
  weights = ~mec_adj,
  data = nhanes_analysis,
  nest = TRUE
)

q_cuts <- svyquantile(
  ~CMB_Score,
  design = design_base,
  quantiles = c(0, 0.25, 0.5, 0.75, 1),
  na.rm = TRUE
)

q_values <- unique(as.numeric(q_cuts$CMB_Score[, 1]))

if (length(q_values) < 3) {
  stop("Weighted quartile cut points are not sufficiently unique.")
}

nhanes_analysis <- nhanes_analysis %>%
  mutate(
    CMB_Q = cut(
      CMB_Score,
      breaks = q_values,
      include.lowest = TRUE,
      labels = FALSE
    ),
    CMB_Trend = as.numeric(CMB_Q),
    CMB_z = as.numeric(scale(CMB_Score))
  )

design_final <- svydesign(
  id = ~SDMVPSU,
  strata = ~SDMVSTRA,
  weights = ~mec_adj,
  data = nhanes_analysis,
  nest = TRUE
)

cat("\nWeighted quartile cut points:\n")
print(q_values)

cat("\nWeighted-quartile group counts:\n")
