# ==============================================================================
# 6. Prediction function
# ==============================================================================

make_newdata <- function(exposure) {
  
  newdat <- data.frame(
    x = seq(0, 24, length.out = 200)
  )
  
  names(newdat)[1] <- exposure
  
  newdat
}

predict_rcs <- function(model, exposure, timing) {
  
  newdat <- make_newdata(exposure)
  
  X <- model.matrix(
    delete.response(terms(model)),
    data = newdat
  )
  
  beta <- coef(model)
  V <- vcov(model)
  
  common <- intersect(colnames(X), names(beta))
  
  X <- X[, common, drop = FALSE]
  beta <- beta[common]
  V <- V[common, common, drop = FALSE]
  
  fit <- as.numeric(X %*% beta)
  
  se <- sqrt(
    pmax(0, rowSums((X %*% V) * X))
  )
  
  ref_fit <- min(fit, na.rm = TRUE)
  
  data.frame(
    hours = newdat[[exposure]],
    yhat = exp(fit - ref_fit),
    lower = exp((fit - 1.96 * se) - ref_fit),
    upper = exp((fit + 1.96 * se) - ref_fit),
    timing = timing
  )
}

plot_weekday <- predict_rcs(
  fit_weekday,
  "sleep_wake_weekday_hours",
  "Weekday"
)

plot_weekend <- predict_rcs(
  fit_weekend,
  "sleep_wake_weekend_hours",
  "Weekend"
)

