# ==============================================================================
# 8. Score construction
# ==============================================================================

VAL_REF <- 1.05
VAL_MILD <- 1.20
VAL_MODERATE <- 1.50

map_or_to_score <- function(hours_val, rcs_plot_data) {
  
  idx <- which.min(
    abs(rcs_plot_data$hours - hours_val)
  )
  
  predicted_or <- rcs_plot_data$yhat[idx]
  
  nadir_or <- min(rcs_plot_data$yhat)
  
  dplyr::case_when(
    predicted_or <= VAL_REF * nadir_or ~ 0L,
    predicted_or <= VAL_MILD * nadir_or ~ 1L,
    predicted_or <= VAL_MODERATE * nadir_or ~ 2L,
    TRUE ~ 3L
  )
}

dat_scored <- dat %>%
  mutate(
    weekday_wake_score = sapply(
      sleep_wake_weekday_hours,
      map_or_to_score,
      rcs_plot_data = plot_weekday
    ),
    
    weekend_wake_score = sapply(
      sleep_wake_weekend_hours,
      map_or_to_score,
      rcs_plot_data = plot_weekend
    ),
    
    sleep_wake_total_score =
      weekday_wake_score +
      weekend_wake_score
  )

# ==============================================================================
# 9. Score association
# ==============================================================================

design_score <- svydesign(
  id = ~SDMVPSU,
  strata = ~SDMVSTRA,
  weights = ~mec_adj,
  data = dat_scored,
  nest = TRUE
)

score_model <- svyglm(
  Moderate_depression_above ~
    sleep_wake_total_score,
  design = design_score,
  family = quasibinomial()
)

score_coef <- summary(score_model)$coefficients

score_result <- data.frame(
  term = "sleep_wake_total_score",
  
  OR = exp(
    score_coef[
      "sleep_wake_total_score",
      "Estimate"
    ]
  ),
  
  lower95 = exp(
    score_coef[
      "sleep_wake_total_score",
      "Estimate"
    ] -
      1.96 *
      score_coef[
        "sleep_wake_total_score",
        "Std. Error"
      ]
  ),
  
  upper95 = exp(
    score_coef[
      "sleep_wake_total_score",
      "Estimate"
    ] +
      1.96 *
      score_coef[
        "sleep_wake_total_score",
        "Std. Error"
      ]
  ),
  
  p_value = score_coef[
    "sleep_wake_total_score",
    "Pr(>|t|)"
  ]
)

print(score_result)

