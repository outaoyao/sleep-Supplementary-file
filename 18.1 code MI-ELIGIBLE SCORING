# ==============================================================================
# 4. Main-analysis score mapping function
# ==============================================================================

VAL_REF <- 1.05
VAL_MILD <- 1.20
VAL_MODERATE <- 1.50

map_main_rule_to_score <- function(hours_val, rcs_rule) {
  
  if (is.na(hours_val)) {
    return(NA_integer_)
  }
  
  idx <- which.min(abs(rcs_rule$hours - hours_val))
  
  predicted_or <- rcs_rule$yhat[idx]
  nadir_or <- min(rcs_rule$yhat, na.rm = TRUE)
  
  dplyr::case_when(
    predicted_or <= VAL_REF * nadir_or ~ 0L,
    predicted_or <= VAL_MILD * nadir_or ~ 1L,
    predicted_or <= VAL_MODERATE * nadir_or ~ 2L,
    TRUE ~ 3L
  )
}

