make_formula <- function(exposure, covars = NULL) {
  
  rhs <- c(exposure, covars)
  
  as.formula(
    paste(
      outcome_var,
      "~",
      paste(rhs, collapse = " + ")
    )
  )
}

fit_model <- function(exposure, covars = NULL) {
  
  svyglm(
    formula = make_formula(exposure, covars),
    design = design,
    family = quasibinomial()
  )
}

format_p <- function(p) {
  
  if (is.na(p)) {
    return(NA_character_)
  }
  
  if (p < 0.001) {
    return("<0.001")
  }
  
  sprintf("%.3f", round(p, 3))
}

extract_or <- function(model, label, var_name) {
  
  cf <- summary(model)$coefficients
  
  if (!var_name %in% rownames(cf)) {
    stop(paste0("Variable not found in model: ", var_name))
  }
  
  est <- cf[var_name, "Estimate"]
  se  <- cf[var_name, "Std. Error"]
  p   <- cf[var_name, "Pr(>|t|)"]
  
  data.frame(
    Model = label,
    beta = est,
    se = se,
    OR = exp(est),
    lower95 = exp(est - 1.96 * se),
    upper95 = exp(est + 1.96 * se),
    p_value = p,
    p_fmt = format_p(p)
  )
}

