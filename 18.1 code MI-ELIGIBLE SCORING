read_model4_rule <- function(path, timing_label) {
  
  x <- read.csv(path)
  
  if (!all(c("hours", "yhat") %in% names(x))) {
    stop(paste0("Rule file lacks required columns hours/yhat: ", path))
  }
  
  if ("model" %in% names(x)) {
    x <- x[x$model == "Model 4", ]
  }
  
  if ("time_type" %in% names(x)) {
    x <- x[x$time_type == timing_label, ]
  } else if ("timing" %in% names(x)) {
    x <- x[x$timing == timing_label, ]
  }
  
  x <- x[order(x$hours), ]
  
  if (nrow(x) == 0) {
    stop(paste0("No Model 4 ", timing_label, " rule found in: ", path))
  }
  
  x
}

