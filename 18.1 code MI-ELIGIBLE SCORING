      1.96 * trend_cf["CMB_Trend", "Std. Error"]
  ),
  p_value = trend_cf["CMB_Trend", "Pr(>|t|)"],
  p_fmt = format_p(
    trend_cf["CMB_Trend", "Pr(>|t|)"]
  )
)

