extract_or <- function(model, var_name) {
  
  cf <- summary(model)$coefficients
  
  est <- cf[var_name, "Estimate"]
  se <- cf[var_name, "Std. Error"]
  p <- cf[var_name, "Pr(>|t|)"]
  
  data.frame(
    term = var_name,
    beta = est,
    se = se,
    OR = exp(est),
    lower95 = exp(est - 1.96 * se),
    upper95 = exp(est + 1.96 * se),
    p_value = p,
    p_fmt = format_p(p)
  )
}

