# ==============================================================================
# 9. CONSTRUCT WEIGHTS
# ==============================================================================

cat("\n── Constructing sample weights ────────────────────────────\n")

dat <- dat %>%
  mutate(
    # Panel-specific phlebotomy weights.
    # 2017-2020 has no WTPH2YR, so WTMECPRP is used for all non-fasting labs.
    wt_cbc = case_when(
      CYCLE == "2017-2020" ~ wt_mec,
      CYCLE == "2021-2023" ~ WTPH2YR_cbc,
      TRUE ~ NA_real_
    ),
    wt_crp = case_when(
      CYCLE == "2017-2020" ~ wt_mec,
      CYCLE == "2021-2023" ~ WTPH2YR_crp,
      TRUE ~ NA_real_
    ),
    wt_biopro = case_when(
      CYCLE == "2017-2020" ~ wt_mec,
      CYCLE == "2021-2023" ~ WTPH2YR_biopro,
      TRUE ~ NA_real_
    ),
    wt_tchol = case_when(
      CYCLE == "2017-2020" ~ wt_mec,
      CYCLE == "2021-2023" ~ WTPH2YR_tchol,
      TRUE ~ NA_real_
    ),
    wt_hdl = case_when(
      CYCLE == "2017-2020" ~ wt_mec,
      CYCLE == "2021-2023" ~ WTPH2YR_hdl,
      TRUE ~ NA_real_
    ),
    
    # Coalesced general phlebotomy weight for backward compatibility.
    # Step 24 can still use this for general non-fasting biomarkers,
    # but panel-specific weights are also provided for audit.
    WTPH2YR_any = coalesce(
      WTPH2YR_cbc,
      WTPH2YR_crp,
      WTPH2YR_biopro,
      WTPH2YR_tchol,
      WTPH2YR_hdl
    ),
    
    wt_phlebotomy = case_when(
      CYCLE == "2017-2020" ~ wt_mec,
      CYCLE == "2021-2023" ~ WTPH2YR_any,
      TRUE ~ NA_real_
    ),
    
    wt_fasting = case_when(
      CYCLE == "2017-2020" ~ WTSAFPRP,
      CYCLE == "2021-2023" ~ WTSAF2YR,
      TRUE ~ NA_real_
    )
  )

