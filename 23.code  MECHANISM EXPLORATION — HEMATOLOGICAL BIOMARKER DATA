safe_nhanes <- function(table_name) {
  cat("  Downloading:", table_name, "...")
  tryCatch({
    df <- nhanes(table_name)
    cat(" OK (", nrow(df), "rows )\n")
    as.data.frame(df)
  }, error = function(e) {
    cat(" FAILED:", conditionMessage(e), "\n")
    NULL
  })
}

select_existing <- function(df, vars) {
  vars_found <- intersect(vars, names(df))
  vars_miss  <- setdiff(vars, names(df))
  
  if (length(vars_miss) > 0) {
    cat("    Missing variables ignored:",
        paste(vars_miss, collapse = ", "), "\n")
  }
  
  df[, vars_found, drop = FALSE]
}

drop_cycle <- function(df) {
  dplyr::select(df, -any_of("CYCLE"))
}

safe_numeric <- function(x) {
  if (is.factor(x)) x <- as.character(x)
  suppressWarnings(as.numeric(x))
}

safe_min <- function(x) {
  x <- safe_numeric(x)
  if (all(is.na(x))) return(NA_real_)
  suppressWarnings(min(x, na.rm = TRUE))
}

safe_max <- function(x) {
  x <- safe_numeric(x)
  if (all(is.na(x))) return(NA_real_)
  suppressWarnings(max(x, na.rm = TRUE))
}

safe_mean <- function(x) {
  x <- safe_numeric(x)
  if (all(is.na(x))) return(NA_real_)
  suppressWarnings(mean(x, na.rm = TRUE))
}

