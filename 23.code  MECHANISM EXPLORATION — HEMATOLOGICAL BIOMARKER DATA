      NA_real_
    ),
    PLR = ifelse(
      !is.na(LBDLYMNO) & LBDLYMNO > 0,
      LBXPLTSI / LBDLYMNO,
      NA_real_
    ),
    AST_ALT_ratio = ifelse(
      !is.na(LBXSATSI) & LBXSATSI > 0,
      LBXSASSI / LBXSATSI,
      NA_real_
    ),
    non_HDL_chol = ifelse(
      !is.na(LBXTC) & !is.na(LBDHDD),
      LBXTC - LBDHDD,
      NA_real_
    ),
    TC_HDL_ratio = ifelse(
      !is.na(LBXTC) & !is.na(LBDHDD) & LBDHDD > 0,
      LBXTC / LBDHDD,
      NA_real_
    )
  )

