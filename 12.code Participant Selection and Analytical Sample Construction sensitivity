# =============================================================================
# Helper: rounded rectangle
# =============================================================================

rounded_rect <- function(x, y, w, h, fill = "white", color = "black",
                         linetype = "solid", linewidth = 0.5) {
  annotate(
    "rect",
    xmin = x - w / 2,
    xmax = x + w / 2,
    ymin = y - h / 2,
    ymax = y + h / 2,
    fill = fill,
    color = color,
    linetype = linetype,
    linewidth = linewidth
  )
}

