################################################################################
# SCRIPT: 12. Participant Selection for MI and Complete-Case Analyses
# STUDY: Sleep Rhythm / Circadian Misalignment and Depressive Symptoms
# DATA: NHANES 2017-March 2020 + 2021-2023
#
# Strategy:
#   Primary analysis:
#     - Keep participants with complete PHQ-9 outcome, sleep exposures,
#       survey design variables, and positive MEC weight.
#     - Exclude pregnant participants.
#     - Do NOT drop participants with missing covariates.
#     - Missing covariates will be handled by multiple imputation later.
#
#   Sensitivity analysis:
#     - Complete-case dataset using all main covariates.
#
# Input:
#   - D:/code/11.Dataset.rds
#
# Outputs:
#   - D:/code/12.Dataset_MI_Eligible.rds
#   - D:/code/12.Dataset_CompleteCase.rds
#   - D:/code/12.Dataset.rds  [alias of complete-case dataset for compatibility]
################################################################################

# 1. Environment & Libraries ---------------------------------------------------

library(tidyverse)
library(tidyr)

base_path <- "D:/code"
setwd(base_path)

qc_dir <- file.path(base_path, "qc_outputs")

if (!dir.exists(qc_dir)) {
  dir.create(qc_dir, recursive = TRUE)
}

# 2. Helper Functions ----------------------------------------------------------

check_required_vars <- function(data, vars, label) {
  missing_vars <- setdiff(vars, names(data))
  
  if (length(missing_vars) > 0) {
    stop(
      "Missing required variables for ",
      label,
      ": ",
      paste(missing_vars, collapse = ", ")
    )
  }
  
  invisible(TRUE)
}

count_missing_by_var <- function(data, vars) {
  data %>%
    summarise(
      across(
        all_of(vars),
        ~ sum(is.na(.x))
      )
    ) %>%
    pivot_longer(
      everything(),
      names_to = "Variable",
      values_to = "N_Missing"
    ) %>%
    arrange(desc(N_Missing), Variable)
}

# 3. Data Loading --------------------------------------------------------------

cat("Loading consolidated NHANES master dataset...\n")

df_raw <- readRDS("11.Dataset.rds")
initial_n <- nrow(df_raw)

cat("Initial master dataset N:", initial_n, "\n")

# 4. Define Variables ----------------------------------------------------------

# Primary outcome variables: required complete
outcome_vars <- c(
  "PHQ9_SCORE",
  "PHQ9_depression_above_10",
  "Moderate_depression_above"
)

# Sensitivity outcome variables: retained, not required for MI eligibility
sensitivity_outcome_vars <- c(
  "PHQ9_depression_above_15",
  "ModSevere_depression_above",
  "PHQ9_no_sleep_SCORE",
  "PHQ9_no_sleep_depression_above_10",
  "PHQ9_no_sleep_depression_above_9",
  "suicidal_ideation_daily"
)

# Core exposure variables: required complete
sleep_vars <- c(
  "sleep_onset_wd_min",
  "wake_time_wd_min",
  "midpoint_wd_min",
  
  "sleep_onset_we_min",
  "wake_time_we_min",
  "midpoint_we_min",
  
  "sleep_onset_wd_hour",
  "wake_time_wd_hour",
  "midpoint_wd_hour",
  
  "sleep_onset_we_hour",
  "wake_time_we_hour",
  "midpoint_we_hour",
  
  "dur_wd",
  "dur_we",
  "dur_wd_cat",
  "dur_we_cat",
  "dur_wd_cat_num",
  "dur_we_cat_num"
)

# Survey design variables: required complete
design_vars <- c(
  "SDMVPSU",
  "SDMVSTRA",
  "mec_adj",
  "int_adj"
)

# Pregnancy exclusion variable
pregnancy_var <- "RIDEXPRG"

# Covariates allowed to be missing in MI-eligible dataset
demographic_covariates <- c(
  "RIDAGEYR",
  "sex",
  "race_ethnicity",
  "education",
  "marital_status",
  "INDFMPIR",
  "PIR_cat",
  "PIR_cat_num",
  "Age_cat",
  "Age_cat_num"
)

main_covariates <- c(
  "BMI_value",
  "BMI_cat",
  "BMI_cat_ordinal",
  
  "smoke_status",
  "smoke_status_label",
  
  "Alcohol_Status",
  "Alcohol_Label",
  
  "diabetes_or_prediabetes",
  "diabetes_or_prediabetes_label",
  
  "htn_status",
  "htn_status_label",
  
  "work_status",
  "work_status_label",
  
  "MET_total",
  "MET_cat_label",
  "MET_cat_num",
  
  "sedentary_min",
  "sedentary_cat_label",
  "sedentary_cat_num"
)

covariate_vars <- c(
  demographic_covariates,
  main_covariates
)

# Variables required for MI eligibility
mi_required_complete_vars <- c(
  outcome_vars,
  sleep_vars,
  design_vars,
  pregnancy_var
)

all_required_vars <- unique(c(
  mi_required_complete_vars,
  sensitivity_outcome_vars,
  covariate_vars
))

check_required_vars(
  df_raw,
  all_required_vars,
  "MI eligible and complete-case participant selection"
)

# 5. Sequential Selection for MI-Eligible Dataset ------------------------------

# Step 1: Complete primary PHQ-9 outcome
df_step1 <- df_raw %>%
  filter(
    !is.na(PHQ9_SCORE),
    !is.na(PHQ9_depression_above_10)
  )

n_after_phq <- nrow(df_step1)

# Step 2: Valid survey design and positive MEC weight
df_step2 <- df_step1 %>%
  filter(
    !is.na(SDMVPSU),
    !is.na(SDMVSTRA),
    !is.na(mec_adj),
    mec_adj > 0
  )

n_after_design_weight <- nrow(df_step2)

# Step 3: Complete core sleep exposure variables
df_step3 <- df_step2 %>%
  drop_na(all_of(sleep_vars))

n_after_sleep <- nrow(df_step3)

# Step 4: Exclude pregnant participants
# RIDEXPRG == 1 indicates pregnant.
# NA is retained because men and non-eligible participants can have missing RIDEXPRG.
df_mi_eligible <- df_step3 %>%
  filter(RIDEXPRG != 1 | is.na(RIDEXPRG))

n_after_preg <- nrow(df_mi_eligible)

# 6. Complete-Case Dataset for Sensitivity Analysis ----------------------------

df_complete_case <- df_mi_eligible %>%
  drop_na(all_of(covariate_vars))

complete_case_n <- nrow(df_complete_case)

# 7. Participant Flow Summary --------------------------------------------------

selection_flow <- tibble(
  Step = c(
    "Initial NHANES 2017-2023 merged dataset",
    "Completed PHQ-9 primary outcome",
    "Valid MEC survey design and positive MEC weight",
    "Completed core sleep timing and duration variables",
    "Excluded pregnant individuals",
    "MI-eligible analytical sample",
    "Complete-case analytical sample"
  ),
  N = c(
    initial_n,
    n_after_phq,
    n_after_design_weight,
    n_after_sleep,
    n_after_preg,
    n_after_preg,
    complete_case_n
  ),
  Excluded_from_previous_step = c(
    0,
    initial_n - n_after_phq,
    n_after_phq - n_after_design_weight,
    n_after_design_weight - n_after_sleep,
    n_after_sleep - n_after_preg,
    0,
    n_after_preg - complete_case_n
  )
)

cat("\n--- PARTICIPANT SELECTION FLOW ---\n")
print(selection_flow)

# 8. Missingness QC ------------------------------------------------------------

cat("\n--- MI-ELIGIBLE DATASET: REQUIRED VARIABLE MISSINGNESS ---\n")

mi_required_missing_check <- count_missing_by_var(
  df_mi_eligible,
  unique(c(outcome_vars, sleep_vars, design_vars))
) %>%
  filter(N_Missing > 0)

if (nrow(mi_required_missing_check) == 0) {
  cat("Success: No missing values in MI-required outcome/exposure/design variables.\n")
} else {
  print(mi_required_missing_check)
}

cat("\n--- MI-ELIGIBLE DATASET: COVARIATE MISSINGNESS FOR IMPUTATION ---\n")

mi_covariate_missingness <- count_missing_by_var(
  df_mi_eligible,
  covariate_vars
) %>%
  mutate(
    N_Total = nrow(df_mi_eligible),
    Missing_Percent = round(100 * N_Missing / N_Total, 2)
  )

print(mi_covariate_missingness)

cat("\n--- COMPLETE-CASE DATASET: MAIN ANALYSIS VARIABLE MISSINGNESS ---\n")

complete_case_missing_check <- count_missing_by_var(
  df_complete_case,
  unique(c(outcome_vars, sleep_vars, design_vars, covariate_vars))
) %>%
  filter(N_Missing > 0)

if (nrow(complete_case_missing_check) == 0) {
  cat("Success: No missing values in complete-case analysis variables.\n")
} else {
  print(complete_case_missing_check)
}

# 9. Key Counts ----------------------------------------------------------------

