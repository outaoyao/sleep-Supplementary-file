wald_test_terms <- function(model, term_index) {
  
  beta <- coef(model)
  V <- vcov(model)
  
  term_index <- term_index[!is.na(term_index)]
  
  if (length(term_index) == 0) {
    return(NA_real_)
  }
  
  b <- beta[term_index]
  VV <- V[term_index, term_index, drop = FALSE]
  
  stat <- as.numeric(t(b) %*% solve(VV) %*% b)
  df <- length(b)
  
  pchisq(stat, df = df, lower.tail = FALSE)
}

get_rcs_pvalues <- function(model, model_name) {
  
  coef_names <- names(coef(model))
  
  rcs_index <- grep(
    exposure_var,
    coef_names,
    fixed = TRUE
  )
  
  if (length(rcs_index) == 0) {
    stop(paste0("No RCS coefficients found in ", model_name))
  }
  
  nonlinear_index <- rcs_index[-1]
  
  data.frame(
    Model = model_name,
    n_rcs_terms = length(rcs_index),
    Overall_P = wald_test_terms(model, rcs_index),
    Nonlinear_P = wald_test_terms(model, nonlinear_index),
    rcs_terms = paste(coef_names[rcs_index], collapse = " | ")
  )
}

format_p <- function(p) {
  
  if (is.na(p)) return(NA_character_)
  if (p < 0.001) return("<0.001")
  
  sprintf("%.3f", round(p, 3))
}

