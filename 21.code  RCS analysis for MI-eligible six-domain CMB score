compare_knots <- function(covars = model4_covars) {
  
  out <- data.frame(
    knots = 3:5,
    AIC = NA_real_
  )
  
  for (k in 3:5) {
    
    fit_k <- fit_svy_rcs(
      covars = covars,
      knots = k
    )
    
    out$AIC[out$knots == k] <- AIC(fit_k)[1]
  }
  
  out
}

