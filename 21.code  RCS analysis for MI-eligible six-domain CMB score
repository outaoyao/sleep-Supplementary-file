get_mode_value <- function(x) {
  x <- x[!is.na(x)]
  names(sort(table(x), decreasing = TRUE))[1]
}

make_reference_newdata <- function(data, covars, n_grid = 200) {
  
  grid <- seq(
    min(data[[exposure_var]], na.rm = TRUE),
    max(data[[exposure_var]], na.rm = TRUE),
    length.out = n_grid
  )
  
  newdat <- data.frame(tmp_exposure = grid)
  names(newdat)[1] <- exposure_var
  
  for (v in covars) {
    
    if (is.factor(data[[v]])) {
      
      ref <- get_mode_value(data[[v]])
      
      newdat[[v]] <- factor(
        ref,
        levels = levels(data[[v]])
      )
      
    } else {
      
      newdat[[v]] <- median(data[[v]], na.rm = TRUE)
    }
  }
  
  newdat
}

predict_rcs_manual <- function(model, covars, model_name) {
  
  newdat <- make_reference_newdata(
    data = dat,
    covars = covars,
    n_grid = 200
  )
  
  X <- model.matrix(
    delete.response(terms(model)),
    data = newdat
  )
  
  beta <- coef(model)
  V <- vcov(model)
  
  common <- intersect(colnames(X), names(beta))
  
  X <- X[, common, drop = FALSE]
  beta <- beta[common]
  V <- V[common, common, drop = FALSE]
  
  fit <- as.numeric(X %*% beta)
  se <- sqrt(pmax(0, rowSums((X %*% V) * X)))
  
  ref_fit <- min(fit, na.rm = TRUE)
  
  data.frame(
    CMB_Score = newdat[[exposure_var]],
    OR = exp(fit - ref_fit),
    lower95 = exp((fit - 1.96 * se) - ref_fit),
    upper95 = exp((fit + 1.96 * se) - ref_fit),
    model = model_name
  )
}

