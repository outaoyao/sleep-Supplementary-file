# 10. Subgroup analysis function
# ==============================================================================

run_subgroup_analysis <- function(sub_var,
                                  compute_strata = sub_var %in% plot_subgroup_vars,
                                  min_n = 50) {
  
  cat(
    "Running:",
    sub_var,
    ifelse(compute_strata, "+ stratified ORs", "+ interaction only"),
    "\n"
  )
  
  vars_to_remove <- c(sub_var, redundancy_map[[sub_var]])
  clean_covs <- setdiff(all_covs, vars_to_remove)
  
  interaction_formula <- as.formula(
    paste0(
      outcome_var,
      " ~ ",
      exposure_var,
      " * ",
      sub_var,
      " + ",
      paste(clean_covs, collapse = " + ")
    )
  )
  
  model_int <- tryCatch(
    svyglm(
      interaction_formula,
      design = design,
      family = quasibinomial()
    ),
    error = function(e) {
      message("Interaction model failed for ", sub_var, ": ", e$message)
      NULL
    }
  )
  
  p_int <- tryCatch(
    {
      if (is.null(model_int)) {
        NA_real_
      } else {
        regTermTest(
          model_int,
          as.formula(paste0("~", exposure_var, ":", sub_var))
        )$p
      }
    },
    error = function(e) {
      message("Interaction test failed for ", sub_var, ": ", e$message)
      NA_real_
    }
  )
  
  if (!compute_strata) {
    return(
      data.frame(
        Subgroup = sub_var,
        Level = NA_character_,
        n_unweighted = NA_integer_,
        beta = NA_real_,
        se = NA_real_,
        OR = NA_real_,
        lower95 = NA_real_,
        upper95 = NA_real_,
        p_value = NA_real_,
        P_Interaction = p_int,
        plot_stratum = FALSE,
        stringsAsFactors = FALSE
      )
    )
  }
  
  levels_sub <- levels(droplevels(dat[[sub_var]]))
  
  stratified_results <- map_df(
    levels_sub,
    function(lvl) {
      
      idx <- dat[[sub_var]] == lvl
      idx[is.na(idx)] <- FALSE
      
      n_sub <- sum(idx)
      
      if (n_sub < min_n) {
        return(NULL)
      }
      
      sub_design <- subset(design, idx)
      
      strat_formula <- as.formula(
        paste0(
          outcome_var,
          " ~ ",
          exposure_var,
          " + ",
          paste(clean_covs, collapse = " + ")
        )
      )
      
      model_strat <- tryCatch(
        svyglm(
          strat_formula,
          design = sub_design,
          family = quasibinomial()
        ),
        error = function(e) {
          message(
            "Stratified model failed: ",
            sub_var,
            " / ",
            lvl,
            ": ",
            e$message
          )
          NULL
        }
      )
      
      if (is.null(model_strat)) {
        return(NULL)
      }
      
      cf <- summary(model_strat)$coefficients
      
      if (!exposure_var %in% rownames(cf)) {
        return(NULL)
      }
      
      est <- cf[exposure_var, "Estimate"]
      se  <- cf[exposure_var, "Std. Error"]
      p   <- cf[exposure_var, "Pr(>|t|)"]
      
      data.frame(
        Subgroup = sub_var,
        Level = as.character(lvl),
        n_unweighted = n_sub,
        beta = est,
        se = se,
        OR = exp(est),
        lower95 = exp(est - 1.96 * se),
        upper95 = exp(est + 1.96 * se),
        p_value = p,
        P_Interaction = p_int,
        plot_stratum = TRUE,
        stringsAsFactors = FALSE
      )
    }
  )
  
  stratified_results
}

