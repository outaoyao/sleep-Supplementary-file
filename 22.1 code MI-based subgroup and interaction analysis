run_subgroup_analysis <- function(sub_var,
                                  compute_strata = sub_var %in% plot_subgroup_vars,
                                  min_n = 50) {
  
  cat(
    "Running:",
    sub_var,
    ifelse(
      compute_strata,
      "+ stratified ORs",
      "+ interaction only"
    ),
    "\n"
  )
  
  vars_to_remove <- c(
    sub_var,
    redundancy_map[[sub_var]]
  )
  
  clean_covs <- setdiff(
    all_covs,
    vars_to_remove
  )
  
  valid_covs_full <- clean_covs[
    sapply(
      clean_covs,
      function(v) is_valid_covariate_in_stratum(dat, v)
    )
  ]
  
  formula_int <- make_interaction_formula(
    outcome = outcome_var,
    exposure = exposure_var,
    sub_var = sub_var,
    covs = valid_covs_full
  )
  
  model_int <- tryCatch(
    svyglm(
      formula_int,
      design = design,
      family = quasibinomial()
    ),
    error = function(e) {
      message("Interaction model failed for ", sub_var, ": ", e$message)
      NULL
    }
  )
  
  p_int <- tryCatch(
    {
      if (is.null(model_int)) {
        NA_real_
      } else {
        regTermTest(
          model_int,
          as.formula(
            paste0("~", exposure_var, ":", sub_var)
          )
        )$p
      }
    },
    error = function(e) {
      message("Interaction test failed for ", sub_var, ": ", e$message)
      NA_real_
    }
  )
  
  if (!compute_strata) {
    
    return(
      data.frame(
        Subgroup = sub_var,
        Level = NA_character_,
        n_unweighted = NA_integer_,
        n_events = NA_integer_,
        beta = NA_real_,
        se = NA_real_,
        OR = NA_real_,
        lower95 = NA_real_,
        upper95 = NA_real_,
        p_value = NA_real_,
        P_Interaction = p_int,
        covariates_removed_no_variation = NA_character_,
        covariates_used = paste(valid_covs_full, collapse = "; "),
        plot_stratum = FALSE,
        stringsAsFactors = FALSE
      )
    )
  }
  
  levels_sub <- levels(
    droplevels(dat[[sub_var]])
  )
  
  map_df(
    levels_sub,
    function(lvl) {
      
      idx <- dat[[sub_var]] == lvl
      idx[is.na(idx)] <- FALSE
      
      n_sub <- sum(idx)
      n_events <- sum(dat[[outcome_var]][idx] == 1, na.rm = TRUE)
      
      if (n_sub < min_n) {
        return(
          data.frame(
            Subgroup = sub_var,
            Level = as.character(lvl),
            n_unweighted = n_sub,
            n_events = n_events,
            beta = NA_real_,
            se = NA_real_,
            OR = NA_real_,
            lower95 = NA_real_,
            upper95 = NA_real_,
            p_value = NA_real_,
            P_Interaction = p_int,
            covariates_removed_no_variation = "Skipped: n below minimum",
            covariates_used = NA_character_,
            plot_stratum = TRUE,
            stringsAsFactors = FALSE
          )
        )
      }
      
      sub_data <- dat[idx, , drop = FALSE]
      
      sub_design <- subset(
        design,
        idx
      )
      
      valid_covs_stratum <- clean_covs[
        sapply(
          clean_covs,
          function(v) is_valid_covariate_in_stratum(sub_data, v)
        )
      ]
      
      removed_covs <- setdiff(
        clean_covs,
        valid_covs_stratum
      )
      
      formula_strat <- make_formula(
        outcome = outcome_var,
        exposure = exposure_var,
        covs = valid_covs_stratum
      )
      
      model_strat <- tryCatch(
        svyglm(
          formula_strat,
          design = sub_design,
          family = quasibinomial()
        ),
        error = function(e) {
          message(
            "Stratified model failed: ",
            sub_var,
            " / ",
            lvl,
            ": ",
            e$message
          )
          NULL
        }
      )
      
      if (is.null(model_strat)) {
        return(
          data.frame(
            Subgroup = sub_var,
            Level = as.character(lvl),
            n_unweighted = n_sub,
            n_events = n_events,
            beta = NA_real_,
            se = NA_real_,
            OR = NA_real_,
            lower95 = NA_real_,
            upper95 = NA_real_,
            p_value = NA_real_,
            P_Interaction = p_int,
            covariates_removed_no_variation = paste(removed_covs, collapse = "; "),
            covariates_used = paste(valid_covs_stratum, collapse = "; "),
            plot_stratum = TRUE,
            stringsAsFactors = FALSE
          )
        )
      }
      
      cf <- summary(model_strat)$coefficients
      
      if (!exposure_var %in% rownames(cf)) {
        return(
          data.frame(
            Subgroup = sub_var,
            Level = as.character(lvl),
            n_unweighted = n_sub,
            n_events = n_events,
            beta = NA_real_,
            se = NA_real_,
            OR = NA_real_,
            lower95 = NA_real_,
            upper95 = NA_real_,
            p_value = NA_real_,
            P_Interaction = p_int,
            covariates_removed_no_variation = paste(removed_covs, collapse = "; "),
            covariates_used = paste(valid_covs_stratum, collapse = "; "),
            plot_stratum = TRUE,
            stringsAsFactors = FALSE
          )
        )
      }
      
      est <- cf[exposure_var, "Estimate"]
      se <- cf[exposure_var, "Std. Error"]
      p <- cf[exposure_var, "Pr(>|t|)"]
      
      data.frame(
        Subgroup = sub_var,
        Level = as.character(lvl),
        n_unweighted = n_sub,
        n_events = n_events,
        beta = est,
        se = se,
        OR = exp(est),
        lower95 = exp(est - 1.96 * se),
        upper95 = exp(est + 1.96 * se),
        p_value = p,
        P_Interaction = p_int,
        covariates_removed_no_variation = paste(removed_covs, collapse = "; "),
        covariates_used = paste(valid_covs_stratum, collapse = "; "),
        plot_stratum = TRUE,
        stringsAsFactors = FALSE
      )
    }
  )
}

