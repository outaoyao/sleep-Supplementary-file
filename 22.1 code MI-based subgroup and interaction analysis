format_p <- function(p) {
  if (is.na(p)) return(NA_character_)
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", round(p, 3))
}

first_existing <- function(data, candidates) {
  found <- candidates[candidates %in% names(data)]
  if (length(found) == 0) return(NA_character_)
  found[1]
}

make_sleep_duration_cat <- function(x) {
  dplyr::case_when(
    is.na(x) ~ NA_character_,
    x < 7 ~ "<7 hours",
    x >= 7 & x <= 9 ~ "7-9 hours",
    x > 9 ~ "≥9 hours"
  )
}

n_unique_nonmissing <- function(x) {
  length(unique(stats::na.omit(x)))
}

is_valid_covariate_in_stratum <- function(data, v) {
  x <- data[[v]]
  
  if (is.null(x)) {
    return(FALSE)
  }
  
  if (all(is.na(x))) {
    return(FALSE)
  }
  
  n_unique_nonmissing(x) >= 2
}

make_formula <- function(outcome, exposure, covs) {
  rhs <- exposure
  
  if (length(covs) > 0) {
    rhs <- paste(rhs, paste(covs, collapse = " + "), sep = " + ")
  }
  
  as.formula(
    paste(outcome, "~", rhs)
  )
}

make_interaction_formula <- function(outcome, exposure, sub_var, covs) {
  rhs <- paste0(exposure, " * ", sub_var)
  
  if (length(covs) > 0) {
    rhs <- paste(rhs, paste(covs, collapse = " + "), sep = " + ")
  }
  
  as.formula(
    paste(outcome, "~", rhs)
  )
}

