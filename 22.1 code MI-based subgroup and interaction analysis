# 15. Forest plot with bold subgroup headers
# ==============================================================================

plot_df <- final_plot_df

x_min <- min(
  0.90,
  floor(min(plot_df$lower95, na.rm = TRUE) * 20) / 20
)

x_max <- max(
  1.20,
  ceiling(max(plot_df$upper95, na.rm = TRUE) * 20) / 20
)

x_text <- x_min
x_plot_min <- x_min
x_plot_max <- x_max

p_forest <- ggplot() +
  
  geom_vline(
    xintercept = 1,
    linetype = "dashed",
    color = "grey45",
    linewidth = 0.45
  ) +
  
  geom_errorbar(
    data = plot_df %>%
      filter(is_header == FALSE, !is.na(OR)),
    aes(
      xmin = lower95,
      xmax = upper95,
      y = y_pos
    ),
    orientation = "y",
    width = 0.18,
    linewidth = 0.75,
    color = "#0072B2"
  ) +
  
  geom_point(
    data = plot_df %>%
      filter(is_header == FALSE, !is.na(OR)),
    aes(
      x = OR,
      y = y_pos
    ),
    color = "#D55E00",
    size = 2.7,
    shape = 15
  ) +
  
  geom_text(
    data = plot_df %>%
      filter(is_header == TRUE),
    aes(
      x = x_text,
      y = y_pos,
      label = Level
    ),
    hjust = 0,
    fontface = "bold",
    size = 3.8,
    color = "black"
  ) +
  
  geom_text(
    data = plot_df %>%
      filter(is_header == FALSE),
    aes(
      x = x_text,
      y = y_pos,
      label = paste0("   ", Level)
    ),
    hjust = 0,
    size = 3.6,
    color = "black"
  ) +
  
  scale_x_continuous(
    limits = c(x_plot_min, x_plot_max),
    breaks = pretty(c(x_plot_min, x_plot_max), n = 6),
    expand = expansion(mult = c(0.02, 0.04))
  ) +
  
  scale_y_continuous(
    limits = c(0.5, max(plot_df$y_pos, na.rm = TRUE) + 1.0),
    expand = expansion(mult = c(0, 0))
  ) +
  
  labs(
    x = NULL,
    y = NULL
  ) +
  
  coord_cartesian(
    clip = "off"
  ) +
  
  theme_classic(base_size = 11) +
  
  theme(
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),
    axis.line.y = element_blank(),
    
    axis.text.x = element_text(
      size = 10,
      color = "black"
    ),
    
    axis.title.x = element_text(
      size = 11,
      color = "black",
      margin = margin(t = 10)
    ),
    
    axis.line.x = element_line(
      color = "black",
      linewidth = 0.45
    ),
    
    axis.ticks.x = element_line(
      color = "black",
      linewidth = 0.35
    ),
    
    panel.grid = element_blank(),
    legend.position = "none",
    
    plot.margin = margin(
      t = 12,
      r = 12,
      b = 12,
      l = 12
    )
  )

ggsave(
