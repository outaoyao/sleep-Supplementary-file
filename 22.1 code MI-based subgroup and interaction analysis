  "Age group, years",
  "Body mass index",
  "Weekday sleep duration",
  "Weekend sleep duration"
)

level_order_map <- list(
  "Sex" = c("Male", "Female"),
  "Age group, years" = c("18-19", "20-39", "40-59", "≥60"),
  "Body mass index" = c(
    "Normal weight or below (<25)",
    "Overweight (25-29.9)",
    "Obese (≥30)"
  ),
  "Weekday sleep duration" = c(
    "7-9 hours",
    "<7 hours",
    "≥9 hours"
  ),
  "Weekend sleep duration" = c(
    "7-9 hours",
    "<7 hours",
    "≥9 hours"
  )
)

plot_ready <- raw_results %>%
  filter(plot_stratum == TRUE) %>%
  left_join(
    interaction_summary,
    by = "Subgroup"
  ) %>%
  mutate(
    Subgroup_Label = dplyr::recode(
      Subgroup,
      !!!label_map,
      .default = Subgroup
    )
  ) %>%
  filter(
    Subgroup_Label %in% subgroup_order
  ) %>%
  mutate(
    Subgroup_Label = factor(
      Subgroup_Label,
      levels = subgroup_order
    )
  )

final_plot_df <- data.frame()

for (sub in subgroup_order) {
  
  sub_data <- plot_ready %>%
    filter(
      as.character(Subgroup_Label) == sub
    )
  
  if (nrow(sub_data) == 0) next
  
  level_order <- level_order_map[[sub]]
  
  sub_data <- sub_data %>%
    mutate(
      Level = factor(
        Level,
        levels = level_order
      )
    ) %>%
    arrange(Level)
  
  header <- data.frame(
    Subgroup_Label = sub,
    Level = sub,
    n_unweighted = NA_integer_,
    n_events = NA_integer_,
    OR = NA_real_,
    lower95 = NA_real_,
    upper95 = NA_real_,
    is_header = TRUE,
    stringsAsFactors = FALSE
  )
  
  levels_df <- sub_data %>%
    transmute(
      Subgroup_Label = as.character(Subgroup_Label),
      Level = as.character(Level),
      n_unweighted = n_unweighted,
      n_events = n_events,
      OR = OR,
      lower95 = lower95,
      upper95 = upper95,
      is_header = FALSE
    )
  
  final_plot_df <- bind_rows(
    final_plot_df,
    header,
    levels_df
  )
}

final_plot_df <- final_plot_df %>%
  mutate(
    row_id = row_number(),
    y_pos = max(row_id) - row_id + 1,
    y_label = ifelse(
      is_header,
      Level,
      paste0("   ", trimws(Level))
    ),
    label_type = ifelse(is_header, "header", "level")
  )

write.csv(
  final_plot_df,
  file.path(out_dir, "Step22_MI_CMB_subgroup_forest_plot_data_clean.csv"),
  row.names = FALSE
)

