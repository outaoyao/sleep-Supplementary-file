wald_test <- function(model, exposure, nonlinear_only = FALSE) {
  
  beta <- coef(model)
  V <- vcov(model)
  
  idx <- grep(
    exposure,
    names(beta),
    fixed = TRUE
  )
  
  if (nonlinear_only) {
    idx <- idx[-1]
  }
  
  if (length(idx) == 0) {
    return(NA_real_)
  }
  
  b <- beta[idx]
  VV <- V[idx, idx, drop = FALSE]
  
  stat <- as.numeric(
    t(b) %*% solve(VV) %*% b
  )
  
  df <- length(b)
  
  pchisq(
    stat,
    df = df,
    lower.tail = FALSE
  )
}

format_p <- function(p) {
  
  if (is.na(p)) {
    return(NA_character_)
  }
  
  if (p < 0.001) {
    return("<0.001")
  }
  
  sprintf("%.3f", round(p, 3))
}

