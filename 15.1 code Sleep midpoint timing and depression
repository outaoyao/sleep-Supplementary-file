# 8. Nadir and score intervals
# ==============================================================================

VAL_REF <- 1.05
VAL_MILD <- 1.20
VAL_MODERATE <- 1.50

summarise_nadir <- function(rcs_data, label) {
  
  idx <- which.min(rcs_data$yhat)
  nadir_or <- rcs_data$yhat[idx]
  
  ref_data <- rcs_data[
    rcs_data$yhat <= VAL_REF * nadir_or,
  ]
  
  data.frame(
    Timing = label,
    Nadir_hour = rcs_data$hours[idx],
    Nadir_OR = nadir_or,
    Reference_start_hour = min(ref_data$hours, na.rm = TRUE),
    Reference_end_hour = max(ref_data$hours, na.rm = TRUE)
  )
}

