make_table1 <- function(
    data,
    output_name,
    remove_zero_missing = TRUE
) {
  
  data <- prepare_table_data(data)
  
  design <- svydesign(
    id = ~SDMVPSU,
    strata = ~SDMVSTRA,
    weights = ~mec_adj,
    nest = TRUE,
    data = data
  )
  
  table_vars <- c(
    "sex_f",
    "age_group_pub",
    "race_f",
    "education_f",
    "marital_f",
    "PIR_cat_f",
    "BMI_cat_f",
    "smoking_f",
    "alcohol_f",
    "work_f",
    "diabetes_f",
    "htn_f",
    "dur_wd_cat_f",
    "dur_we_cat_f",
    "MET_cat_f",
    "sedentary_cat_f"
  )
  
  var_labels <- c(
    sex_f = "Sex",
    age_group_pub = "Age group",
    race_f = "Race/ethnicity",
    education_f = "Education",
    marital_f = "Marital status",
    PIR_cat_f = "Family income-to-poverty ratio",
    BMI_cat_f = "BMI category",
    smoking_f = "Smoking status",
    alcohol_f = "Alcohol use",
    work_f = "Work status",
    diabetes_f = "Diabetes/prediabetes",
    htn_f = "Hypertension",
    dur_wd_cat_f = "Weekday sleep duration",
    dur_we_cat_f = "Weekend sleep duration",
    MET_cat_f = "Leisure-time physical activity",
    sedentary_cat_f = "Sedentary time"
  )
  
  dep_tab <- table(data$PHQ9_group)
  
  results <- list()
  
  # ---------------------------------------------------------------------------
  # N row
  # ---------------------------------------------------------------------------
  
  results[[1]] <- tibble(
    Characteristic = "N",
    Overall = as.character(nrow(data)),
    PHQ9_lt10 = as.character(dep_tab["PHQ-9 <10"]),
    PHQ9_ge10 = as.character(dep_tab["PHQ-9 ≥10"]),
    P_value = ""
  )
  
  # ---------------------------------------------------------------------------
  # Variables
  # ---------------------------------------------------------------------------
  
  for (var in table_vars) {
    
    p <- tryCatch(
      
      svychisq(
        as.formula(paste0("~", var, " + PHQ9_group")),
        design = design,
        statistic = "Wald"
      )$p.value,
      
      error = function(e) NA_real_
    )
    
    results[[length(results) + 1]] <- tibble(
      Characteristic = var_labels[[var]],
      Overall = "",
      PHQ9_lt10 = "",
      PHQ9_ge10 = "",
      P_value = fmt_p(p)
    )
    
    for (lv in levels(data[[var]])) {
      
      n_all <- sum(data[[var]] == lv, na.rm = TRUE)
      
      n_no <- sum(
        data[[var]] == lv &
          data$PHQ9_group == "PHQ-9 <10",
        na.rm = TRUE
      )
      
      n_yes <- sum(
        data[[var]] == lv &
          data$PHQ9_group == "PHQ-9 ≥10",
        na.rm = TRUE
      )
      
      if (
        remove_zero_missing &&
        lv == "Missing" &&
        n_all == 0 &&
        n_no == 0 &&
        n_yes == 0
      ) next
      
      pct_all <- weighted_pct(design, var, lv)
      
      pct_no <- weighted_pct(
        design,
        var,
        lv,
        "PHQ-9 <10"
      )
      
      pct_yes <- weighted_pct(
        design,
        var,
        lv,
        "PHQ-9 ≥10"
      )
      
      results[[length(results) + 1]] <- tibble(
        Characteristic = paste0("  ", lv),
        Overall = fmt_n_pct(n_all, pct_all),
        PHQ9_lt10 = fmt_n_pct(n_no, pct_no),
        PHQ9_ge10 = fmt_n_pct(n_yes, pct_yes),
        P_value = ""
      )
    }
  }
  
  # ---------------------------------------------------------------------------
  # Final table
  # ---------------------------------------------------------------------------
  
  table1 <- bind_rows(results) %>%
    rename(
      `PHQ-9 <10` = PHQ9_lt10,
      `PHQ-9 ≥10` = PHQ9_ge10,
      `P value` = P_value
    )
  
  write.csv(
    table1,
    file.path(base_path, output_name),
    row.names = FALSE,
    na = "",
    fileEncoding = "UTF-8"
  )
  
  # ---------------------------------------------------------------------------
  # Console summary
  # ---------------------------------------------------------------------------
  
  weighted_pop <- sum(weights(design))
  
  weighted_dep <- svytable(~PHQ9_group, design)
  
  cat("\nSaved:", output_name, "\n")
  
  cat("Unweighted N:",
      nrow(data),
      "\n")
  
  cat(
    "Weighted population:",
    format(round(weighted_pop), big.mark = ","),
    "\n"
  )
  
  cat(
    "Weighted depressive symptoms:",
    format(round(weighted_dep["PHQ-9 ≥10"]), big.mark = ","),
    sprintf(
      "(%.2f%%)\n",
      prop.table(weighted_dep)["PHQ-9 ≥10"] * 100
    )
  )
  
  invisible(table1)
}

