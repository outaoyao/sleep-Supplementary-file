prepare_table_data <- function(data) {
  
  data %>%
    mutate(
      
      # -----------------------------------------------------------------------
      # PHQ-9 group
      # -----------------------------------------------------------------------
      
      PHQ9_group = factor(
        PHQ9_depression_above_10,
        levels = c(0, 1),
        labels = c("PHQ-9 <10", "PHQ-9 ≥10")
      ),
      
      # -----------------------------------------------------------------------
      # Age group
      # -----------------------------------------------------------------------
      
      age_group_pub = case_when(
        !is.na(RIDAGEYR) & RIDAGEYR >= 18 & RIDAGEYR < 20 ~ "18–19 years",
        !is.na(RIDAGEYR) & RIDAGEYR >= 20 & RIDAGEYR < 40 ~ "20–39 years",
        !is.na(RIDAGEYR) & RIDAGEYR >= 40 & RIDAGEYR < 60 ~ "40–59 years",
        !is.na(RIDAGEYR) & RIDAGEYR >= 60 ~ "≥60 years",
        TRUE ~ NA_character_
      ),
      
      age_group_pub = factor(
        age_group_pub,
        levels = c(
          "18–19 years",
          "20–39 years",
          "40–59 years",
          "≥60 years"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Sex
      # -----------------------------------------------------------------------
      
      sex_f = factor(
        sex,
        levels = c("Male", "Female")
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Race
      # -----------------------------------------------------------------------
      
      race_f = add_missing_level(race_ethnicity),
      
      # -----------------------------------------------------------------------
      # Education
      # -----------------------------------------------------------------------
      
      education_f = add_missing_level(education),
      
      # -----------------------------------------------------------------------
      # Marital status
      # -----------------------------------------------------------------------
      
      marital_f = add_missing_level(marital_status),
      
      # -----------------------------------------------------------------------
      # Smoking
      # -----------------------------------------------------------------------
      
      smoking_f = factor(
        smoke_status,
        levels = c(0, 1, 2),
        labels = c(
          "Never smoker",
          "Former smoker",
          "Current smoker"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Alcohol
      # -----------------------------------------------------------------------
      
      alcohol_f = factor(
        Alcohol_Status,
        levels = c(0, 1, 2),
        labels = c(
          "Never",
          "Non-heavy ever drinker",
          "Heavy alcohol use"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Work status
      # -----------------------------------------------------------------------
      
      work_f = factor(
        work_status,
        levels = c(0, 1),
        labels = c(
          "Currently employed",
          "Not currently working"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Diabetes
      # -----------------------------------------------------------------------
      
      diabetes_f = factor(
        diabetes_or_prediabetes,
        levels = c(0, 1),
        labels = c(
          "No",
          "Diabetes/prediabetes"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Hypertension
      # -----------------------------------------------------------------------
      
      htn_f = factor(
        htn_status,
        levels = c(0, 1),
        labels = c(
          "No",
          "Yes"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # PIR
      # -----------------------------------------------------------------------
      
      PIR_cat_f = add_missing_level(PIR_cat),
      
      # -----------------------------------------------------------------------
      # BMI
      # -----------------------------------------------------------------------
      
      BMI_cat_f = factor(
        BMI_cat,
        levels = c(
          "Underweight",
          "Normal",
          "Overweight",
          "Obese"
        ),
        labels = c(
          "Underweight",
          "Normal weight",
          "Overweight",
          "Obesity"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Weekday sleep duration
      # -----------------------------------------------------------------------
      
      dur_wd_cat_f = factor(
        dur_wd_cat,
        levels = c(
          "7-9 hours",
          "<7 hours",
          "≥9 hours"
        ),
        labels = c(
          "7–9 h",
          "<7 h",
          "≥9 h"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Weekend sleep duration
      # -----------------------------------------------------------------------
      
      dur_we_cat_f = factor(
        dur_we_cat,
        levels = c(
          "7-9 hours",
          "<7 hours",
          "≥9 hours"
        ),
        labels = c(
          "7–9 h",
          "<7 h",
          "≥9 h"
        )
      ) %>%
        add_missing_level(),
      
      # -----------------------------------------------------------------------
      # Physical activity
      # -----------------------------------------------------------------------
      
      MET_cat_f = add_missing_level(MET_cat_label),
      
      # -----------------------------------------------------------------------
      # Sedentary time
      # -----------------------------------------------------------------------
      
      sedentary_cat_f = factor(
        sedentary_cat_label,
        levels = c("<6h", "6-8h", ">8h"),
        labels = c(
          "<6 h/day",
          "6–8 h/day",
          ">8 h/day"
        )
      ) %>%
        add_missing_level()
    )
}

