# =============================================================================
# Helper functions
# =============================================================================

fmt_p <- function(p) {
  if (is.na(p)) return("—")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

add_missing_level <- function(x) {
  x <- factor(x)
  forcats::fct_na_value_to_level(x, level = "Missing")
}

fmt_n_pct <- function(n, pct) {
  sprintf("%d (%.2f%%)", n, pct)
}

fmt_mean_sd <- function(x) {
  x <- x[!is.na(x)]
  
  if (length(x) == 0) return("—")
  
  sprintf("%.1f (%.1f)", mean(x), sd(x))
}

weighted_pct <- function(design, var, level, group = NULL) {
  
  d <- design
  
  if (!is.null(group)) {
    d <- subset(d, PHQ9_group == group)
  }
  
  tab <- svytable(as.formula(paste0("~", var)), d)
  
  if (!(level %in% names(tab))) return(0)
  
  as.numeric(tab[level] / sum(tab) * 100)
}

