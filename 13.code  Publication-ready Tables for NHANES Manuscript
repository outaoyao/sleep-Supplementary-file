# =============================================================================
# SMD functions
# =============================================================================

fmt_n_pct_raw <- function(n, denom) {
  
  if (is.na(denom) || denom == 0) return("—")
  
  sprintf(
    "%d (%.1f%%)",
    n,
    100 * n / denom
  )
}

smd_cont <- function(x, group) {
  
  g <- levels(group)
  
  x1 <- x[group == g[1] & !is.na(x)]
  
  x2 <- x[group == g[2] & !is.na(x)]
  
  if (length(x1) < 2 || length(x2) < 2) {
    return(NA_real_)
  }
  
  pooled_sd <- sqrt(
    (
      ((length(x1) - 1) * var(x1)) +
        ((length(x2) - 1) * var(x2))
    ) /
      (length(x1) + length(x2) - 2)
  )
  
  if (is.na(pooled_sd) || pooled_sd == 0) {
    return(0)
  }
  
  abs(mean(x1) - mean(x2)) / pooled_sd
}

smd_binary <- function(p1, p2) {
  
  if (any(is.na(c(p1, p2)))) {
    return(NA_real_)
  }
  
  abs(
    2 * asin(sqrt(p1)) -
      2 * asin(sqrt(p2))
  )
}

smd_cat <- function(x, group) {
  
  x <- factor(x)
  
  g <- levels(group)
  
  smds <- sapply(levels(x), function(lv) {
    
    p1 <- mean(
      x[group == g[1]] == lv,
      na.rm = TRUE
    )
    
    p2 <- mean(
      x[group == g[2]] == lv,
      na.rm = TRUE
    )
    
    smd_binary(p1, p2)
  })
  
  max(smds, na.rm = TRUE)
}

safe_chisq <- function(x, group) {
  
  tbl <- table(
    x,
    group,
    useNA = "no"
  )
  
  tryCatch(
    
    chisq.test(
      tbl,
      simulate.p.value = TRUE,
      B = 5000
    )$p.value,
    
    error = function(e) NA_real_
  )
}

safe_ttest <- function(x, group) {
  
  g <- levels(group)
  
  tryCatch(
    
    t.test(
      x[group == g[1]],
      x[group == g[2]]
    )$p.value,
    
    error = function(e) NA_real_
  )
}

# =============================================================================
# Build Table S1
