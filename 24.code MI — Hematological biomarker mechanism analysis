prepare_biomarkers_one <- function(data, registry) {
  
  for (i in seq_len(nrow(registry))) {
    
    b <- registry$biomarker[i]
    z <- paste0(b, "_z")
    
    x <- clean_range_vec(data[[b]], registry$lower[i], registry$upper[i])
    
    if (isTRUE(registry$do_log[i])) {
      x <- log1p(x)
    }
    
    data[[z]] <- as.numeric(scale(x))
  }
  
  data
}

