fit_cmb_to_biomarker_one <- function(data, biomarker_z, weight_var, covars) {
  
  needed <- c(biomarker_z, "CMB_Score", weight_var, "SDMVPSU", "SDMVSTRA", covars)
  
  model_data <- data %>%
    filter(if_all(all_of(needed), ~!is.na(.x))) %>%
    filter(.data[[weight_var]] > 0)
  
  if (nrow(model_data) < 100) return(NULL)
  
  des <- svydesign(
    id = ~SDMVPSU,
    strata = ~SDMVSTRA,
    weights = as.formula(paste0("~", weight_var)),
    nest = TRUE,
    data = model_data
  )
  
  fit <- tryCatch(
    svyglm(
      as.formula(
        paste(
          biomarker_z,
          "~",
          paste(c("CMB_Score", covars), collapse = " + ")
        )
      ),
      design = des
    ),
    error = function(e) NULL
  )
  
  if (is.null(fit)) return(NULL)
  
  cf <- summary(fit)$coefficients
  
  if (!"CMB_Score" %in% rownames(cf)) return(NULL)
  
  tibble(
    n = nrow(model_data),
    beta = cf["CMB_Score", "Estimate"],
    se = cf["CMB_Score", "Std. Error"]
  )
}

fit_biomarker_to_dep_one <- function(data, biomarker_z, weight_var, covars) {
  
  needed <- c("Depression", biomarker_z, "CMB_Score", weight_var, "SDMVPSU", "SDMVSTRA", covars)
  
  model_data <- data %>%
    filter(if_all(all_of(needed), ~!is.na(.x))) %>%
    filter(.data[[weight_var]] > 0)
  
  if (nrow(model_data) < 100) return(NULL)
  if (length(unique(model_data$Depression)) < 2) return(NULL)
  
  des <- svydesign(
    id = ~SDMVPSU,
    strata = ~SDMVSTRA,
    weights = as.formula(paste0("~", weight_var)),
    nest = TRUE,
    data = model_data
  )
  
  fit <- tryCatch(
    svyglm(
      as.formula(
        paste(
          "Depression ~",
          paste(c(biomarker_z, "CMB_Score", covars), collapse = " + ")
        )
      ),
      design = des,
      family = quasibinomial()
    ),
    error = function(e) NULL
  )
  
  if (is.null(fit)) return(NULL)
  
  cf <- summary(fit)$coefficients
  
  if (!biomarker_z %in% rownames(cf)) return(NULL)
  
  tibble(
    n = nrow(model_data),
    beta = cf[biomarker_z, "Estimate"],
    se = cf[biomarker_z, "Std. Error"]
  )
}

fit_attenuation_components_one <- function(data, biomarker_z, weight_var, covars) {
  
  needed <- c("Depression", "CMB_Score", biomarker_z, weight_var, "SDMVPSU", "SDMVSTRA", covars)
  
  model_data <- data %>%
    filter(if_all(all_of(needed), ~!is.na(.x))) %>%
    filter(.data[[weight_var]] > 0)
  
  if (nrow(model_data) < 100) return(NULL)
  if (length(unique(model_data$Depression)) < 2) return(NULL)
  
  des <- svydesign(
    id = ~SDMVPSU,
    strata = ~SDMVSTRA,
    weights = as.formula(paste0("~", weight_var)),
    nest = TRUE,
    data = model_data
  )
  
  fit_base <- tryCatch(
    svyglm(
      as.formula(
        paste(
          "Depression ~",
          paste(c("CMB_Score", covars), collapse = " + ")
        )
      ),
      design = des,
      family = quasibinomial()
    ),
    error = function(e) NULL
  )
  
  fit_adj <- tryCatch(
    svyglm(
      as.formula(
        paste(
          "Depression ~",
          paste(c("CMB_Score", biomarker_z, covars), collapse = " + ")
        )
      ),
      design = des,
      family = quasibinomial()
    ),
    error = function(e) NULL
  )
  
  if (is.null(fit_base) || is.null(fit_adj)) return(NULL)
  
  cf0 <- summary(fit_base)$coefficients
  cf1 <- summary(fit_adj)$coefficients
  
  if (!"CMB_Score" %in% rownames(cf0)) return(NULL)
  if (!"CMB_Score" %in% rownames(cf1)) return(NULL)
  
  tibble(
    n = nrow(model_data),
    b0 = cf0["CMB_Score", "Estimate"],
    se_b0 = cf0["CMB_Score", "Std. Error"],
    b1 = cf1["CMB_Score", "Estimate"],
    se_b1 = cf1["CMB_Score", "Std. Error"]
  )
}

result_list <- list()

for (i in seq_len(nrow(log_decision))) {
  
  b <- log_decision$biomarker[i]
  z <- paste0(b, "_z")
  label <- log_decision$label[i]
  panel <- log_decision$panel[i]
  weight_var <- log_decision$weight_var[i]
  
  cat("Running biomarker:", label, "\n")
  
  cmb_to_bio_raw <- map_dfr(
    analysis_list,
    ~fit_cmb_to_biomarker_one(.x, z, weight_var, covars)
  )
  
  bio_to_dep_raw <- map_dfr(
    analysis_list,
    ~fit_biomarker_to_dep_one(.x, z, weight_var, covars)
  )
  
  atten_raw <- map_dfr(
    analysis_list,
    ~fit_attenuation_components_one(.x, z, weight_var, covars)
  )
  
  pooled_cmb_to_bio <- pool_rubin(cmb_to_bio_raw$beta, cmb_to_bio_raw$se)
  pooled_bio_to_dep <- pool_rubin(bio_to_dep_raw$beta, bio_to_dep_raw$se)
  pooled_b0 <- pool_rubin(atten_raw$b0, atten_raw$se_b0)
  pooled_b1 <- pool_rubin(atten_raw$b1, atten_raw$se_b1)
  
  base_significant_pooled <- !is.na(pooled_b0$estimate) &&
    !is.na(pooled_b0$se) &&
    abs(pooled_b0$estimate / pooled_b0$se) >= 1.96
  
  if (base_significant_pooled) {
    
    attenuation_pct <- 100 * (pooled_b0$estimate - pooled_b1$estimate) / pooled_b0$estimate
    
    attenuation_se <- delta_atten_pooled(
      b0 = pooled_b0$estimate,
      b1 = pooled_b1$estimate,
      se_b0 = pooled_b0$se,
      se_b1 = pooled_b1$se
    )
    
    attenuation_lower <- attenuation_pct - 1.96 * attenuation_se
    attenuation_upper <- attenuation_pct + 1.96 * attenuation_se
    
    attenuation_status <- "Reported descriptively"
    
  } else {
    
    attenuation_pct <- NA_real_
    attenuation_se <- NA_real_
    attenuation_lower <- NA_real_
    attenuation_upper <- NA_real_
    
    attenuation_status <- "Suppressed because pooled base CMB effect was non-significant"
  }
  
  result_list[[b]] <- tibble(
    biomarker = b,
    label = label,
    panel = panel,
    weight_var = weight_var,
    do_log = log_decision$do_log[i],
    skewness_observed = log_decision$skewness_observed[i],
    
    n_cmb_to_bio_median = ifelse(nrow(cmb_to_bio_raw) > 0, median(cmb_to_bio_raw$n), NA_real_),
    beta_cmb_to_bio = pooled_cmb_to_bio$estimate,
    se_cmb_to_bio = pooled_cmb_to_bio$se,
    p_cmb_to_bio = pooled_cmb_to_bio$p,
    
    n_bio_to_dep_median = ifelse(nrow(bio_to_dep_raw) > 0, median(bio_to_dep_raw$n), NA_real_),
    beta_bio_to_dep = pooled_bio_to_dep$estimate,
    se_bio_to_dep = pooled_bio_to_dep$se,
    OR_bio_to_dep = exp(pooled_bio_to_dep$estimate),
    lower_bio_to_dep = exp(pooled_bio_to_dep$lower),
    upper_bio_to_dep = exp(pooled_bio_to_dep$upper),
    p_bio_to_dep = pooled_bio_to_dep$p,
    
    n_attenuation_median = ifelse(nrow(atten_raw) > 0, median(atten_raw$n), NA_real_),
    beta_cmb_base_pooled = pooled_b0$estimate,
    se_cmb_base_pooled = pooled_b0$se,
    p_cmb_base_pooled = pooled_b0$p,
    beta_cmb_adjusted_pooled = pooled_b1$estimate,
    se_cmb_adjusted_pooled = pooled_b1$se,
    p_cmb_adjusted_pooled = pooled_b1$p,
    pooled_base_cmb_significant = base_significant_pooled,
    attenuation_pct = attenuation_pct,
    attenuation_se = attenuation_se,
    attenuation_lower = attenuation_lower,
    attenuation_upper = attenuation_upper,
    attenuation_status = attenuation_status
  )
}

