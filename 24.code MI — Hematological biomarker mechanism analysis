clean_range_vec <- function(x, lower, upper) {
  x <- suppressWarnings(as.numeric(x))
  x[is.infinite(x)] <- NA_real_
  x[x < lower | x > upper] <- NA_real_
  x
}

skewness_fun <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) < 10) return(NA_real_)
  s <- sd(x)
  if (is.na(s) || s == 0) return(NA_real_)
  mean((x - mean(x))^3) / s^3
}

pool_rubin <- function(est, se) {
  ok <- !is.na(est) & !is.na(se)
  est <- est[ok]
  se  <- se[ok]
  m <- length(est)
  
  if (m == 0) {
    return(tibble(
      m = 0L,
      estimate = NA_real_,
      se = NA_real_,
      lower = NA_real_,
      upper = NA_real_,
      p = NA_real_
    ))
  }
  
  qbar <- mean(est)
  ubar <- mean(se^2)
  b <- if (m > 1) var(est) else 0
  total_var <- ubar + (1 + 1 / m) * b
  total_se <- sqrt(total_var)
  z <- qbar / total_se
  
  tibble(
    m = m,
    estimate = qbar,
    se = total_se,
    lower = qbar - 1.96 * total_se,
    upper = qbar + 1.96 * total_se,
    p = 2 * pnorm(abs(z), lower.tail = FALSE)
  )
}

format_p <- function(p) {
  if (is.na(p)) return(NA_character_)
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", round(p, 3))
}

fmt_ci <- function(or, lo, hi) {
  if (any(is.na(c(or, lo, hi)))) return(NA_character_)
  paste0(sprintf("%.3f", or), " (", sprintf("%.3f", lo), "-", sprintf("%.3f", hi), ")")
}

delta_atten_pooled <- function(b0, b1, se_b0, se_b1) {
  if (any(is.na(c(b0, b1, se_b0, se_b1)))) return(NA_real_)
  if (b0 == 0) return(NA_real_)
  sqrt((100 * b1 / b0^2)^2 * se_b0^2 + (100 / b0)^2 * se_b1^2)
}

