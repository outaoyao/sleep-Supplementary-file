    sum(pooled_results$candidate_dual_fdr, na.rm = TRUE),
    "No",
    ifelse(
      all(is.na(pooled_results$attenuation_pct)),
      NA_real_,
      max(abs(pooled_results$attenuation_pct), na.rm = TRUE)
    ),
    ifelse(
      all(is.na(c(pooled_results$attenuation_lower, pooled_results$attenuation_upper))),
      NA_real_,
      max(abs(c(pooled_results$attenuation_lower, pooled_results$attenuation_upper)), na.rm = TRUE)
    )
  )
)

