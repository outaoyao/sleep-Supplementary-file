harmonise_one_imp <- function(df, imp_id) {
  
  df <- df %>%
    mutate(
      SEQN = as.numeric(SEQN),
      Depression = as.numeric(as.character(Moderate_depression_above)),
      .imp = imp_id
    )
  
  for (v in intersect(factor_covars, names(df))) {
    df[[v]] <- as.factor(df[[v]])
  }
  
  dat <- df %>%
    left_join(cmb_score_keep, by = "SEQN") %>%
    left_join(
      heme_data %>%
        select(-any_of(c("SDMVPSU", "SDMVSTRA", "RIDAGEYR", "RIAGENDR", "RIDRETH3"))),
      by = "SEQN"
    )
  
  if (nrow(dat) != nrow(df)) {
    stop("Row count changed after merge in imputation ", imp_id)
  }
  
  dat
}

